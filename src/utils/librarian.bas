' Librarian.bas
' Copyleft 2012, 2026 The Mojon Twins
'
' Reparte una lista de binarios (ya comprimidos) en páginas de RAM del
' Spectrum 128K y genera librarian.h con la tabla de recursos y get_resource.
'
'  * Cada recurso tiene un #define RES_<NOMBRE> sacado del nombre del archivo
'    (title.bin -> RES_TITLE, level1c.bin -> RES_LEVEL1C).
'  * Páginas configurables (por defecto 3, 4, 6, 7). La 1 es del WYZ player.
'  * En la lista se ignoran las líneas vacías y los comentarios (#).
'
' Uso: librarian list=lista.txt out=librarian.h [dir=salida] [pages=3,4,6,7]

#include "cmdlineparser.bi"

Dim As Integer f1, f2, fl, i, n, mempointer, currentMem, ramPage, resId, nPages
Dim As Integer ramPages (7)
Dim myBin (16383) As uByte
Dim currentBin (16383) As uByte
Dim As String linea, outDir, resName, pagesStr, baseName
Dim As String names (255)
Dim As Integer resPage (255), resOffset (255)

Sub fail (msg As String)
	Print "** ERROR ** " & msg
	End 1
End Sub

Sub writePage (outDir As String, page As Integer, buf () As uByte, size As Integer)
	Dim As Integer f = FreeFile
	Dim As String fn = outDir & "/RAM" & page & ".bin"
	Kill fn
	Open fn For Binary Access Write As #f
	If size > 0 Then Put #f, , buf (0), size
	Close f
	Print "  RAM" & page & ".bin: " & size & " bytes"
End Sub

sclpParseAttrs
If Not sclpGIsDef ("list") Or Not sclpGIsDef ("out") Then
	Print "uso: librarian list=lista.txt out=librarian.h [dir=salida] [pages=3,4,6,7]"
	End 1
End If

outDir = sclpGetValue ("dir"): If outDir = "" Then outDir = "."
pagesStr = sclpGetValue ("pages"): If pagesStr = "" Then pagesStr = "3,4,6,7"
nPages = 0
pagesStr = pagesStr & ","
While Instr (pagesStr, ",") And nPages < 8
	i = Instr (pagesStr, ",")
	If Trim (Left (pagesStr, i - 1)) <> "" Then ramPages (nPages) = Val (Left (pagesStr, i - 1)): nPages = nPages + 1
	pagesStr = Mid (pagesStr, i + 1)
Wend

Print "THE LIBRARIAN v3.100 ~ " & sclpGetValue ("list")

f1 = FreeFile
If Open (sclpGetValue ("list") For Input As f1) Then fail "no puedo abrir " & sclpGetValue ("list")

ramPage = 0: mempointer = 0: resId = 0

While Not Eof (f1)
	Line Input #f1, linea
	linea = Trim (linea)
	If linea = "" Or Left (linea, 1) = "#" Then Continue While

	f2 = FreeFile
	If Open (linea For Binary Access Read As #f2) Then fail "no puedo abrir " & linea
	currentMem = Lof (f2)
	If currentMem > 16384 Then fail linea & " ocupa " & currentMem & " bytes: no cabe en una página"
	If currentMem > 0 Then Get #f2, , currentBin (0), currentMem
	Close f2

	' ¿Cabe en la página actual?
	If currentMem + mempointer > 16384 Then
		writePage outDir, ramPages (ramPage), myBin (), mempointer
		ramPage = ramPage + 1
		mempointer = 0
		If ramPage >= nPages Then fail "no quedan páginas de RAM para " & linea
	End If

	For i = 0 To currentMem - 1
		myBin (mempointer + i) = currentBin (i)
	Next i

	' Nombre del recurso: nombre del archivo sin ruta ni extensión
	baseName = linea
	While Instr (baseName, "/"): baseName = Mid (baseName, Instr (baseName, "/") + 1): Wend
	While Instr (baseName, "\"): baseName = Mid (baseName, Instr (baseName, "\") + 1): Wend
	If Instr (baseName, ".") Then baseName = Left (baseName, Instr (baseName, ".") - 1)
	resName = "RES_"
	For i = 1 To Len (baseName)
		Dim As String c = Ucase (Mid (baseName, i, 1))
		If (c >= "A" And c <= "Z") Or (c >= "0" And c <= "9") Then resName = resName & c Else resName = resName & "_"
	Next i

	names (resId) = resName
	resPage (resId) = ramPages (ramPage)
	resOffset (resId) = 49152 + mempointer
	Print "  " & resName & " (" & linea & "): RAM" & ramPages (ramPage) & " + " & mempointer & ", " & currentMem & " bytes"

	mempointer = mempointer + currentMem
	resId = resId + 1
Wend
Close f1

If mempointer > 0 Then writePage outDir, ramPages (ramPage), myBin (), mempointer

fl = FreeFile
Open sclpGetValue ("out") For Output As fl
Print #fl, "// librarian.h"
Print #fl, "// Generated by The Librarian v3.100"
Print #fl, "// Copyleft 2012, 2026 The Mojon Twins"
Print #fl, ""
For i = 0 To resId - 1
	Print #fl, "#define " & names (i) & Space (24 - Len (names (i))) & i
Next i
Print #fl, ""
Print #fl, "typedef struct {"
Print #fl, "	unsigned char ramPage;"
Print #fl, "	unsigned int ramOffset;"
Print #fl, "} RESOURCE;"
Print #fl, ""
Print #fl, "const RESOURCE resources [] = {"
For i = 0 To resId - 1
	Print #fl, "	{" & resPage (i) & ", " & resOffset (i) & "}" & IIf (i < resId - 1, ",", " ") & "	// " & names (i)
Next i
Print #fl, "};"
Print #fl, ""
Print #fl, "void get_resource (unsigned char res, unsigned int dest) {"
Print #fl, "	unpack_RAMn (resources [res].ramPage, (unsigned char *) resources [res].ramOffset, (unsigned char *) dest);"
Print #fl, "}"
Close fl
Print resId & " recursos en " & (ramPage + 1) & " página(s)"
