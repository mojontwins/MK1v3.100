# Prueba del intérprete msc4 (tests/script) con los datos de bootee.
# Ver tests/script/run.sh.

ROOMS = 30
TEXT WIDTH = 20
ALIAS %ENTRADAS = 1
ALIAS %FUEGOS = 2
ALIAS %SALUDO = 3
ALIAS %OBJ = 4
ALIAS %RESP = 5

ENTERING GAME
	IF TRUE
	THEN
		%ENTRADAS = 0
		%FUEGOS = 0
		%SALUDO = 0
		%OBJ = 0
	END
END

ENTERING ANY
	IF TRUE
	THEN
		INC %ENTRADAS, 1
		TEXT "MSC4 OK"
		PRINT TILE 30, 18 = %ENTRADAS
	END
END

ENTERING SCREEN 1
	IF %SALUDO = 0
	THEN
		%SALUDO = 1
		TEXT BOX "HOLA DESDE MSC4. PULSA UNA TECLA!"
	END
	# RERUN: la primera vez PARAM vale 255
	IF PARAM <> 7
	THEN
		DECOS
			1, 7, 20
			2, 7, 21
		END
		CALL PINTA
		RERUN 7
	END
	IF PARAM = 7
	THEN
		SET TILE 3, 7 = 22
	END
END

PRESS FIRE AT SCREEN 1
	IF TRUE
	THEN
		INC %FUEGOS, 1
		SET TILE 6, 7 = %FUEGOS
		SOUND 1
	END
	IF %FUEGOS >= 3
	THEN
		WARP TO 2, 7, 4
	END
END

# DIALOG + RERUN (como en LANGSPECS.md): la opción elegida vuelve como PARAM
PRESS FIRE AT SCREEN 2
	IF PARAM = 2
	THEN
		SET TILE 1, 1 = 22
		BREAK
	END
	IF PARAM < 4
	THEN
		BREAK
	END
	# Al entrar PARAM vale 255
	IF TRUE
	THEN
		%RESP = DIALOG "UNO", "DOS", "TRES"
		RERUN %RESP
	END
END

PLAYER GOT SOMETHING
	IF TRUE
	THEN
		%OBJ = HOTSPOT
		PRINT TILE 30, 2 = 16
	END
END

SUB PINTA
	IF TRUE
	THEN
		SET TILE 4, 7 = 23
		BREAK
	END
	IF TRUE
	THEN
		SET TILE 5, 7 = 24
	END
END
