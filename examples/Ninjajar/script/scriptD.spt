# Ninjajar - Nivel 12: el tutorial (mapa D)
# Convertido del script original de 2014 (msc3) a msc4.

ROOMS = 10
TEXT WIDTH = 24


##############################################################################
# LEVEL D
##############################################################################

# Nivel tutorial
# flag 2: Controla la aparición o no del primer cartel del juego
# flag 3: Controla el hacha. 0: No, 1: Si, 2: Usada
# flag 4: Controla el touchplate. 0: No, 1: Si

ENTERING GAME
	IF TRUE
	THEN
		SET FLAG 2 = 0
		SET FLAG 3 = 0
		SET FLAG 4 = 0
		SET FLAG 5 = 0
		SET FLAG 6 = 0
	END
END

ENTERING SCREEN 0
	IF TRUE
	THEN
		SET TILE (0, 2) = 25
		SET TILE (0, 3) = 24
		SET TILE (0, 4) = 23
		SET TILE (1, 4) = 25
		SET TILE (0, 5) = 23
		SET TILE (1, 5) = 24
		SET TILE (0, 6) = 23
		SET TILE (1, 6) = 23
		SET TILE (2, 6) = 25
		SET TILE (0, 7) = 23
		SET TILE (1, 7) = 23
		SET TILE (2, 7) = 24
	END
END

ENTERING SCREEN 1
	IF TRUE
	THEN
		SET TILE (9, 7) = 32
	END

	IF FLAG 2 = 0
	THEN
		SET FIRE ZONE 32, 0, 47, 159
	END
END

# Hablar, matar
PRESS FIRE AT SCREEN 1
	IF FLAG 2 = 0
	THEN
		TEXT BOX "NINJAJAR, PRUEBA A HABLAR CON LOS PERSONAJES PULSANDO ;ABAJO;"
		SET FLAG 2 = 1
		REENTER
	END

	IF PLAYER NEAR 9, 7
	THEN
		TEXT BOX "AMADOR: HOLA, NINJAJAR, SOY AMADOR EL LE<ADOR. VEO QUE POR FIN VUELVES DE TUS AVENTURAS."
		TEXT BOX "AMADOR: EL PUEBLO ESTA CRUZANDO EL BOSQUE. YO VIVO AQUI, PUEDES HABLAR CONMIGO SIEMPRE QUE QUIERAS."
		TEXT BOX "AMADOR: ANTES DE SEGUIR, PRUEBA A DARLE UN MECO AL MURCIELAGO ESE DE AHI. ACERCATE Y PULSA ;FIRE;."
		REENTER
	END
END

# Evitar pinchos
ENTERING SCREEN 2
	IF TRUE
	THEN
		SET TILE (2, 6) = 32
	END
END

PRESS FIRE AT SCREEN 2
	IF PLAYER NEAR 2, 6
	THEN
		TEXT BOX "AMADOR: TEN CUIDADO CON LOS PINCHOS. ERES FUERTE PERO NO SUPERMAN, TE HARIAN BASTANTE DA<O."
		REENTER
	END
END

# Romper piedros
ENTERING SCREEN 3
	IF TRUE
	THEN
		SET TILE (3, 6) = 32
	END
END

PRESS FIRE AT SCREEN 3
	IF PLAYER NEAR 3, 6
	THEN
		TEXT BOX "AMADOR: TU PU<ETAZO ES TAN FUERTE QUE PUEDE ROMPER ALGUNAS PIEDRAS. PRUEBA CUALES SE ROMPEN Y CUALES NO!"
		REENTER
	END
END

# Romper piedros-estrella
ENTERING SCREEN 4
	IF TRUE
	THEN
		SET TILE (2, 7) = 32
	END
END

PRESS FIRE AT SCREEN 4
	IF PLAYER NEAR 2, 7
	THEN
		TEXT BOX "AMADOR: CUANDO ENCUENTRES BLOQUES ESTRELLA, ROMPELOS! A VECES SALEN MONEDAS. Y EL DINERO MOOOOLA."
		TEXT BOX "AMADOR: CON LAS MONEDAS SE PUEDEN COMPRAR VIDAS EN TIENDAS QUE HAY POR AHI, Y ESO SIEMPRE VIENE BIEN."
		REENTER
	END
END

#6,6,6,7
# Entrar en casas
ENTERING SCREEN 5
	IF TRUE
	THEN
		SET TILE (6, 6) = 38
		SET TILE (7, 6) = 39
		SET TILE (8, 6) = 40
		SET TILE (6, 7) = 35
		SET TILE (7, 7) = 36
		SET TILE (8, 7) = 37
		SET TILE (3, 7) = 32
	END
END

PRESS FIRE AT SCREEN 5
	IF PLAYER NEAR 3, 7
	THEN
		TEXT BOX "AMADOR: AHI DELANTE HAY UNA CASA. PUEDES ENTRAR PULSANDO ;ABAJO; CERCA DE LA PUERTA. PRUEBALO."
		REDRAW
		SET TILE (6, 6) = 38
		SET TILE (7, 6) = 39
		SET TILE (8, 6) = 40
		SET TILE (6, 7) = 35
		SET TILE (7, 7) = 36
		SET TILE (8, 7) = 37
		SET TILE (3, 7) = 32
	END

	IF PLAYER NEAR 8, 7
	THEN
		EXTERN 0
		WARP TO 9, 3, 7
	END
END

# Coger objetos y usarlos
ENTERING SCREEN 6
	IF TRUE
	THEN
		SET TILE (7, 7) = 32
	END

	IF FLAG 3 = 0
	THEN
		SET TILE (5, 2) = 44
		SET FIRE ZONE 65, 17, 95, 47
	END

	IF FLAG 3 <> 2
	THEN
		SET TILE (12, 6) = 42
		SET TILE (12, 7) = 43
	END
END

PRESS FIRE AT SCREEN 6
	IF PLAYER NEAR 5, 2
	IF FLAG 3 = 0
	THEN
		SET FLAG 3 = 1
		SOUND 20
		EXTERN 5, 44
		REENTER
	END

	IF PLAYER NEAR 7, 7
	IF FLAG 3 = 0
	THEN
		TEXT BOX "AMADOR: A VECES NECESITARAS OBJETOS PARA SEGUIR. TRAEME EL HACHA DE AHI ARRIBA Y TE ABRIRE LA PUERTA."
		REENTER
	END

	IF PLAYER NEAR 7, 7
	IF FLAG 3 = 1
	THEN
		SET TILE (12, 6) = 0
		SET TILE (12, 7) = 42
		EXTERN 5, 0
		SHOW
		SOUND 22
		PAUSE 30
		SET TILE (12, 7) = 0
		SHOW
		SOUND 22
		SET FLAG 3 = 2
	END
END

# Touchplates
ENTERING SCREEN 7
	IF TRUE
	THEN
		SET TILE (5, 4) = 41
		SET TILE (2, 7) = 32
	END

	IF FLAG 4 = 1
	THEN
		SET TILE (6, 7) = 9
		SET TILE (10, 7) = 9
	END
END

PRESS FIRE AT SCREEN 7
	IF PLAYER NEAR 2, 7
	IF FLAG 4 = 0
	THEN
		TEXT BOX "AMADOR: VES LA BALDOSA DE AHI? SON ESPECIALES. SI PULSAS ;ABAJO; MIENTRAS LAS PISAS, PASAN COSAS."
		REENTER
	END

	IF PLAYER NEAR 2, 7
	IF FLAG 4 = 1
	THEN
		TEXT BOX "AMADOR: VES? ES COMO MAGIA. PERO EN REALIDAD ES CIENCIA Y TECNOLOGIA. LA MAGIA NO EXISTE, TONTO."
		REENTER
	END

	IF PLAYER NEAR 5, 3
	IF FLAG 4 = 0
	THEN
		SET FLAG 4 = 1
		SOUND 16
		SET TILE (6, 7) = 9
		SET TILE (10, 7) = 9
	END
END

# Bola de arroz
ENTERING SCREEN 8
	IF TRUE
	THEN
		SET TILE (4, 7) = 32
	END
END

PRESS FIRE AT SCREEN 8
	IF PLAYER NEAR 4, 7
	THEN
		TEXT BOX "AMADOR: CASI ESTA. LA FASE ACABA CUANDO TE COMES LA BOLA DE ARROZ."
		REENTER
	END
END

# Casa
ENTERING SCREEN 9
	IF TRUE
	THEN
		SET TILE (3, 2) = 26
		SET TILE (4, 2) = 27
		SET TILE (5, 2) = 27
		SET TILE (6, 2) = 27
		SET TILE (7, 2) = 27
		SET TILE (8, 2) = 27
		SET TILE (9, 2) = 27
		SET TILE (10, 2) = 27
		SET TILE (11, 2) = 28
		SET TILE (3, 3) = 29
		SET TILE (11, 3) = 30

		SET TILE (4, 4) = 45
		SET TILE (5, 4) = 45
		SET TILE (7, 4) = 45
		SET TILE (8, 4) = 45
		SET TILE (10, 4) = 45

		SET TILE (4, 5) = 45
		SET TILE (5, 5) = 45
		SET TILE (6, 5) = 45
		SET TILE (7, 5) = 45
		SET TILE (8, 5) = 45
		SET TILE (9, 5) = 45
		SET TILE (10, 5) = 45

		SET TILE (4, 6) = 45
		SET TILE (5, 6) = 46
		SET TILE (6, 6) = 45
		SET TILE (7, 6) = 46
		SET TILE (8, 6) = 45
		SET TILE (9, 6) = 46
		SET TILE (10, 6) = 45

		SET TILE (3, 7) = 45
		SET TILE (4, 7) = 45
		SET TILE (5, 7) = 32
		SET TILE (6, 7) = 45
		SET TILE (7, 7) = 20
		SET TILE (8, 7) = 18
		SET TILE (9, 7) = 20
		SET TILE (10, 7) = 45

		SET FIRE ZONE 32, 0, 47, 159
	END
END

PRESS FIRE AT SCREEN 9
	IF PLAYER NEAR 8, 7
	THEN
		MUSIC 22
	END

	IF PLAYER NEAR 2, 7
	THEN
		EXTERN 0
		WARP TO 5, 8, 7
	END

	IF PLAYER NEAR 5, 7
	THEN
		TEXT BOX "AMADOR: BIENVENIDO A MI CASA. HUELE UN POCO A CHOTUNO, PERO ES CONFORTABLE."
		REENTER
	END
END
