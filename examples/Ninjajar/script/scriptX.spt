# Ninjajar - Nivel 18: el final bueno (mapa X)
# Convertido del script original de 2014 (msc3) a msc4.

ROOMS = 3
TEXT WIDTH = 24


##############################################################################
# LEVEL X - ANIMACIÓN CHUNGA FINAL BUENO
##############################################################################

ENTERING SCREEN 0
	IF TRUE
	THEN
		MUSIC 21
		SET TILE (3, 7) = 36
		SET TILE (4, 7) = 37
		SET TILE (3, 8) = 38
		SET TILE (4, 8) = 39
		SET TILE (6, 8) = 32
		SET FIRE ZONE 0, 0, 239, 159
	END
END

PRESS FIRE AT SCREEN 0
	IF TRUE
	THEN
		PAUSE 15
		# Secuencia
		TEXT BOX "NOVIA: GONZALO, HA SIDO UN ERROR INTENTAR PROPASARTE. AHORA TE VAS A ENTERAR."
		REDRAW
		SET TILE (3, 7) = 36
		SET TILE (4, 7) = 37
		SET TILE (3, 8) = 38
		SET TILE (4, 8) = 39

		SOUND 17
		SET TILE (6, 8) = 0
		PRINT TILE (12, 15) = 33
		SHOW
		PAUSE 10

		PRINT TILE (12, 15) = 0
		PRINT TILE (11, 14) = 33
		SHOW
		PAUSE 10

		PRINT TILE (11, 14) = 0
		PRINT TILE (10, 14) = 33
		SHOW
		PAUSE 10

		PRINT TILE (10, 14) = 0
		PRINT TILE (9, 14) = 33
		SHOW
		PAUSE 10

		#
	END

	IF TRUE
	THEN
		REDRAW
		PRINT TILE (9, 14) = 0
		SET TILE (3, 7) = 20
		SET TILE (4, 7) = 21
		SET TILE (3, 8) = 22
		SET TILE (4, 8) = 23
		SHOW
		SOUND 21
		PAUSE 15

		SET TILE (3, 7) = 24
		SET TILE (4, 7) = 25
		SET TILE (3, 8) = 26
		SET TILE (4, 8) = 27
		SHOW
		SOUND 22
		PAUSE 15

		SET TILE (3, 7) = 28
		SET TILE (4, 7) = 21
		SET TILE (3, 8) = 22
		SET TILE (4, 8) = 23
		SHOW
		SOUND 23
		PAUSE 15

		SET TILE (3, 7) = 24
		SET TILE (4, 7) = 29
		SET TILE (3, 8) = 26
		SET TILE (4, 8) = 27
		SHOW
		SOUND 22
		PAUSE 15
	END

	IF TRUE
	THEN
		SET TILE (3, 7) = 20
		SET TILE (4, 7) = 21
		SET TILE (3, 8) = 22
		SET TILE (4, 8) = 23
		SHOW
		SOUND 23
		PAUSE 15

		SET TILE (3, 7) = 24
		SET TILE (4, 7) = 25
		SET TILE (3, 8) = 30
		SET TILE (4, 8) = 27
		SHOW
		SOUND 21
		PAUSE 15

		SET TILE (3, 7) = 20
		SET TILE (4, 7) = 21
		SET TILE (3, 8) = 22
		SET TILE (4, 8) = 31
		SHOW
		SOUND 22
		PAUSE 15

		SET TILE (3, 7) = 28
		SET TILE (4, 7) = 25
		SET TILE (3, 8) = 26
		SET TILE (4, 8) = 27
		SHOW
		SOUND 23
		PAUSE 15
	END

	IF TRUE
	THEN
		SET TILE (3, 7) = 24
		SET TILE (4, 7) = 25
		SET TILE (3, 8) = 26
		SET TILE (4, 8) = 27
		SHOW
		SOUND 22
		PAUSE 15

		SET TILE (3, 7) = 28
		SET TILE (4, 7) = 21
		SET TILE (3, 8) = 22
		SET TILE (4, 8) = 23
		SHOW
		SOUND 23
		PAUSE 15

		SET TILE (3, 7) = 24
		SET TILE (4, 7) = 29
		SET TILE (3, 8) = 26
		SET TILE (4, 8) = 27
		SHOW
		SOUND 22
		PAUSE 15

		SET TILE (3, 7) = 20
		SET TILE (4, 7) = 21
		SET TILE (3, 8) = 22
		SET TILE (4, 8) = 23
		SHOW
		SOUND 23
		PAUSE 15
	END

	IF TRUE
	THEN
		SET TILE (3, 7) = 24
		SET TILE (4, 7) = 25
		SET TILE (3, 8) = 30
		SET TILE (4, 8) = 27
		SHOW
		SOUND 21
		PAUSE 15

		SET TILE (3, 7) = 20
		SET TILE (4, 7) = 21
		SET TILE (3, 8) = 22
		SET TILE (4, 8) = 31
		SHOW
		SOUND 22
		PAUSE 15

		WARP TO 1, 12, 8
	END
END

ENTERING SCREEN 1
	IF TRUE
	THEN
		SET TILE (3, 7) = 44
		SET TILE (4, 7) = 45
		SET TILE (3, 8) = 46
		SET TILE (4, 8) = 47
		PRINT TILE (10, 15) = 33
		SET FIRE ZONE 0, 0, 239, 159
	END
END

PRESS FIRE AT SCREEN 1
	IF TRUE
	THEN
		SHOW
		PAUSE 5

		REDRAW
		SET TILE (3, 7) = 40
		SET TILE (4, 7) = 41
		SET TILE (3, 8) = 42
		SET TILE (4, 8) = 43
		PRINT TILE (10, 15) = 0
		PRINT TILE (10, 16) = 32
		SHOW
		PAUSE 5

		SET TILE (3, 7) = 44
		SET TILE (4, 7) = 45
		SET TILE (3, 8) = 46
		SET TILE (4, 8) = 47
		SHOW
		PAUSE 5

		SET TILE (3, 7) = 40
		SET TILE (4, 7) = 41
		SET TILE (3, 8) = 42
		SET TILE (4, 8) = 43
		SHOW
		PAUSE 5

		SET TILE (3, 7) = 44
		SET TILE (4, 7) = 45
		SET TILE (3, 8) = 46
		SET TILE (4, 8) = 47
		SHOW
		PAUSE 5
	END

	IF TRUE
	THEN
		SET TILE (3, 7) = 40
		SET TILE (4, 7) = 41
		SET TILE (3, 8) = 42
		SET TILE (4, 8) = 43
		SHOW
		PAUSE 5

		SET TILE (3, 7) = 44
		SET TILE (4, 7) = 45
		SET TILE (3, 8) = 46
		SET TILE (4, 8) = 47
		SHOW
		PAUSE 5

		SET TILE (3, 7) = 40
		SET TILE (4, 7) = 41
		SET TILE (3, 8) = 42
		SET TILE (4, 8) = 43
		SHOW
		PAUSE 15

		TEXT BOX "GONZALO: PIEDAD, POR FAVOR, NO ME PEGUES MAS. MI PERICARDIO..."

		REDRAW
		SET TILE (3, 7) = 40
		SET TILE (4, 7) = 41
		SET TILE (3, 8) = 42
		SET TILE (4, 8) = 43
		SET TILE (5, 8) = 32
		SHOW
		PAUSE 15
		TEXT BOX "NOVIA: TE LO MERECES POR GUARRERAS Y POR DROGARME PARA RAPTARME."
		TEXT BOX "NOVIA: ES QUE CREIAS QUE NO ME IBA A DESPERTAR NUNCA? MONO MIERDOSO."
	END

	IF TRUE
	THEN

		REDRAW
		SET TILE (3, 7) = 40
		SET TILE (4, 7) = 41
		SET TILE (3, 8) = 42
		SET TILE (4, 8) = 43
		SET TILE (5, 8) = 32
		SHOW
		PAUSE 15
		SET TILE (5, 8) = 35
		SOUND 16
		SHOW
		PAUSE 15

		TEXT BOX "NOVIA: NINJAJAR? QUE HACES AQUI? CREIA QUE ESTABAS DE MISIONES Y TAL."
		TEXT BOX "NOVIA: QUE HAS VENIDO A RESCATARME? ANDA YA, PERO SI TODO EL KUNG FU QUE SABES TE LO ENSE<E YO!"
		TEXT BOX "NOVIA: BUENO, AUN ASI ME HALAGA QUE HAYAS VENIDO. VAMOS A LA PLAYA A PASAR EL DIA Y CELEBRARLO."

		EXTERN 0

		# Final bueno!
		SET FLAG 28 = 1
		CALL ENDING
		GAME ENDING
	END
END


# Las cinemáticas del final (antes en cutscene.h). EXTERN 1 pone los textos
# en modo cinemática (debajo del dibujo, sin recuadro) y EXTERN 2, n muestra
# el dibujo ENDINGn. EXTERN 3 acaba.
SUB ENDING
	IF TRUE
	THEN
		MUSIC 9
		EXTERN 1
	END

	# Final malo
	IF $28 = 0
	THEN
		EXTERN 2, 4
		TEXT BOX "NINJAJAR LLEGA A PEPINONI. EL SOL BRILLA Y EL AGUA ESTA BUENISIMA."
		TEXT BOX "TODO ESTA EN CALMA HASTA QUE DOS FIGURAS APARECEN EN EL HORIZONTE..."
		TEXT BOX "NINJAJAR SE FROTA LOS OJOS... NO SE LO PUEDE CREER!"
		EXTERN 2, 3
		TEXT BOX "NOVIA: NINJAJAR! QUE HACES AQUI?"
		TEXT BOX "NOVIA: YO VENGO DEL CASTILLO ESE DE ALLI. POR LO VISTO ME HABIAN DROGADO Y RAPTADO"
		TEXT BOX "NOVIA: CUANDO DESPERTE VI AL CULPABLE, EL MONO GONZALO, Y LE DI UNA PALIZA"
		TEXT BOX "NOVIA: FUERA, ME ENCONTRE A ESTE SE<OR TAN AMABLE QUE ME HA INVITADO A LA PLAYA"
		TEXT BOX "NOVIA: Y TU, DONDE TE HABIAS METIDO?"
		TEXT BOX "ZUNDA ZUNDA: BAH, DEJALO, GUAPA. VAMOS AL CHIRINGUITO, TE INVITO A UN TROPI FRUTI"
		TEXT BOX "NOVIA: DE ACUERDO! ME ENCANTAN LOS TROPI FRUTIS!"
		TEXT BOX "NOVIA: ADIOS, NINJAJAR. YA NOS VEREMOS ALGUN DIA."
		TEXT BOX "ZUNDA ZUNDA: HE HE HEE..."
		EXTERN 2, 4
		TEXT BOX "AL FINAL NINJAJAR NO CATARA TOTETE."
		TEXT BOX "SI NO TE GUSTA ESTE FINAL, HABER ELEGIDO IR AL CASTILLO."
		TEXT BOX "TONTOLCULO."
	END

	# Final bueno
	IF $28 <> 0
	THEN
		EXTERN 2, 1
		TEXT BOX "NOVIA: QUE BIEN SE ESTA AQUI, VERDAD? HACIA TIEMPO QUE QUERIA VENIR A LA PLAYA"
		TEXT BOX "NOVIA: ME HALAGA QUE HAYAS VENIDO A RESCATARME, PERO NO HACIA NINGUNA FALTA!"
		TEXT BOX "NOVIA: SOY EXPERTA EN KUNG-FU, YA SABES. OYE, NO TIENES CALOR CON ESA MASCARA?"
		EXTERN 2, 2
		TEXT BOX "NOVIA: DESDE LUEGO, CHERIL, NO ENTIENDO ESTE ROLLO TAN RARO QUE TE HA DADO"
		TEXT BOX "NOVIA: DE VESTIRTE DE NINJA E IR POR AHI DANDO GUANTAZOS CON ESOS GUANTES VIEJOS"
		TEXT BOX "NOVIA: PERO BUENO, A MI ME CAES BIEN ASI. VAMOS AL BAR A POR UN TROPI FRUTI?"
	END

	IF TRUE
	THEN
		EXTERN 3
	END
END

