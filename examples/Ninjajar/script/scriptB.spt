# Ninjajar - Nivel 11: las tiendas (mapa B); cada tienda según LEVEL
# Convertido del script original de 2014 (msc3) a msc4.

ROOMS = 12
TEXT WIDTH = 24


##############################################################################
# LEVEL SHOPS
##############################################################################

# Flags
# 2 -> Descripción inicial
# 3 -> Controla el fire_zone variable
# 4 -> Lo que cuesta una vida
# 5 -> mensajes del personaje
# 6 -> Truco entrar en tienda/salir

# Tiendas, según LEVEL
# 4 - tienda michael knight (pantallas 0, 1)
# 8 - tienda walker texas ranger (pantallas 2, 3)
# 12 - tienda bud spencer (pantallas 4, 5)
# 15 - tienda chuck norris (pantallas 6, 7)
# 19 - tienda Alex Kidd (pantallas 8, 9)
# 20 - bifurcación (pantallas 10, 11)

ENTERING GAME
	IF TRUE
	THEN
		SET FLAG 2 = 0
		SET FLAG 3 = 0
		SET FLAG 4 = 15
		SET FLAG 5 = 0
		SET FLAG 6 = 0
	END

	# Warps para las distintas tiendas según el mapa
	IF LEVEL = 8
	THEN
		SET FLAG 4 = 20
		WARP TO 2, 3, 4
	END

	IF LEVEL = 12
	THEN
		SET FLAG 4 = 25
		WARP TO 4, 2, 4
	END

	IF LEVEL = 15
	THEN
		SET FLAG 4 = 25
		WARP TO 6, 2, 4
	END

	IF LEVEL = 19
	THEN
		SET FLAG 4 = 30
		WARP TO 8, 2, 4
	END

	# Bifurcación final
	IF LEVEL = 20
	THEN
		WARP TO 10, 2, 4
	END
END

ENTERING SCREEN 0, 2, 4, 6, 8
	IF TRUE
	THEN
		SET TILE (7, 6) = 25
		SET TILE (8, 6) = 26
		SET TILE (9, 6) = 27
		SET TILE (7, 7) = 28
		SET TILE (8, 7) = 29
		SET TILE (9, 7) = 30
		SET TILE (12, 7) = 18
		SET TILE (6, 7) = 24
		SET FLAG 7 = 0
		SET FIRE ZONE 224, 0, 239, 159
	END

	IF FLAG 6 = 1
	THEN
		REPOSTN 8, 7
	END
END

PRESS FIRE AT SCREEN 0
	IF PLAYER NEAR 8, 7
	THEN
		EXTERN 0
		WARP TO 1, 3, 7
	END

	IF PLAYER NEAR 12, 7
	THEN
		TEXT BOX "SIGUE TU AVENTURA!"
		SET FLAG 6 = 0
		REENTER
	END

	IF PLAYER NEAR 6, 7
	THEN
		TEXT BOX "TIENDA DE MICHAEL KNIGHT"
		SET FLAG 6 = 0
		REENTER
	END

	IF PLAYER IN_X 224, 239
	THEN
		WIN GAME
	END
END

PRESS FIRE AT SCREEN 2
	IF PLAYER NEAR 8, 7
	THEN
		EXTERN 0
		WARP TO 3, 3, 7
	END

	IF PLAYER NEAR 12, 7
	THEN
		TEXT BOX "SIGUE TU AVENTURA!"
		SET FLAG 6 = 0
		REENTER
	END

	IF PLAYER NEAR 6, 7
	THEN
		TEXT BOX "TIENDA DE WALKER, TEXAS RANGER"
		SET FLAG 6 = 0
		REENTER
	END

	IF PLAYER IN_X 224, 239
	THEN
		WIN GAME
	END
END

PRESS FIRE AT SCREEN 4
	IF PLAYER NEAR 8, 7
	THEN
		EXTERN 0
		WARP TO 5, 3, 7
	END

	IF PLAYER NEAR 12, 7
	THEN
		TEXT BOX "SIGUE TU AVENTURA!"
		SET FLAG 6 = 0
		REENTER
	END

	IF PLAYER NEAR 6, 7
	THEN
		TEXT BOX "TIENDA DE BUD SPENCER, NADADOR HOSTIADOR"
		SET FLAG 6 = 0
		REENTER
	END

	IF PLAYER IN_X 224, 239
	THEN
		WIN GAME
	END
END

PRESS FIRE AT SCREEN 6
	IF PLAYER NEAR 8, 7
	THEN
		EXTERN 0
		WARP TO 7, 3, 7
	END

	IF PLAYER NEAR 12, 7
	THEN
		TEXT BOX "SIGUE TU AVENTURA!"
		SET FLAG 6 = 0
		REENTER
	END

	IF PLAYER NEAR 6, 7
	THEN
		TEXT BOX "TIENDA DE CHUCK NORRIS, DIOS DEL DOLOR"
		SET FLAG 6 = 0
		REENTER
	END

	IF PLAYER IN_X 224, 239
	THEN
		WIN GAME
	END
END

PRESS FIRE AT SCREEN 8
	IF PLAYER NEAR 8, 7
	THEN
		EXTERN 0
		WARP TO 9, 3, 7
	END

	IF PLAYER NEAR 12, 7
	THEN
		TEXT BOX "SIGUE TU AVENTURA!"
		SET FLAG 6 = 0
		REENTER
	END

	IF PLAYER NEAR 6, 7
	THEN
		TEXT BOX "TIENDA DE ALEX KIDD, PRINCIPE DE RADAXIAN"
		SET FLAG 6 = 0
		REENTER
	END

	IF PLAYER IN_X 224, 239
	THEN
		WIN GAME
	END
END

ENTERING SCREEN 1
	IF TRUE
	THEN
		SET TILE (10, 5) = 32
		SET TILE (10, 6) = 33
		SET TILE (2, 2) = 20
		SET TILE (12, 2) = 21
		SET TILE (6, 1) = 44
		SET TILE (7, 1) = 45
		SET TILE (8, 1) = 46
		SET TILE (7, 4) = 16
		SET FLAG 3 = 0
		SET FLAG 6 = 1
	END

	IF FLAG 2 = 0
	THEN
		SET FIRE ZONE 58, 0, 139, 239
	END

	IF FLAG 2 = 1
	THEN
		SET FIRE ZONE 97, 49, 127, 79
	END
END

PRESS FIRE AT SCREEN 1
	IF PLAYER NEAR 10, 6
	IF FLAG 5 = 5
	THEN
		TEXT BOX "MICHAEL KNIGHT: TA TANANANA NANANANA..."
		REENTER
	END

	IF PLAYER NEAR 10, 6
	IF FLAG 5 = 4
	THEN
		SET FLAG 5 = 5
		TEXT BOX "MICHAEL KNIGHT: MIRA, ME HAS CAIDO BIEN... TE REGALO UNA VIDA."
		INC LIFE, 1
		SOUND 20
		REENTER
	END

	IF PLAYER NEAR 10, 6
	IF FLAG 5 = 3
	THEN
		SET FLAG 5 = 4
		TEXT BOX "MICHAEL KNIGHT: LE HE ENCONTRADO A KITT UNOS RAYONES CON PINTURA ROJA, PERO NO ME HAN DEJADO NOTITA NI NADA."
		REENTER
	END

	IF PLAYER NEAR 10, 6
	IF FLAG 5 = 2
	THEN
		SET FLAG 5 = 3
		TEXT BOX "MICHAEL KNIGHT: DATE PRISA, QUIERO CERRAR. HE QUEDADO CON BONNIE Y DEVON, ME VAN A MAQUEAR EL BUGA."
		REENTER
	END

	IF PLAYER NEAR 10, 6
	IF FLAG 5 = 1
	THEN
		SET FLAG 5 = 2
		TEXT BOX "MICHAEL KNIGHT: AH, TE COMPRENDO BIEN... ERES UN HOMBRE QUE NO EXISTE, EN UN MUNDO LLENO DE PELIGROS."
		REENTER
	END

	IF PLAYER NEAR 10, 6
	IF FLAG 5 = 0
	THEN
		MUSIC 10
		SET FLAG 5 = 1
		TEXT BOX "MICHAEL KNIGHT: OYE, TE INTERESA UN DEPORTIVO NEGRO SEMINUEVO? POCOS KILOMETROS..."
		REENTER
	END

	IF FLAG 2 = 0
	THEN
		SET FLAG 2 = 1
		TEXT BOX "MICHAEL KNIGHT: BIENVENIDO A MI TIENDA. PUEDES COMPRAR VIDAS A 15 MONEDAS."
		REENTER
	END

	IF PLAYER NEAR 7, 4
	IF FLAG 1 < #4
	THEN
		TEXT BOX "MICHAEL KNIGHT: NO TE QUEDAN SUFICIENTES MONEDAS, Y AQUI NO SE FIA!"
		SET FLAG 3 = 1
		PY = 80
		REENTER
	END

	IF PLAYER NEAR 7, 4
	THEN
		TEXT BOX "MICHAEL KNIGHT: GRACIAS!"
		DEC FLAG 1, #4
		INC LIFE, 1
		SOUND 20
		PY = 80
		REENTER
	END
END

ENTERING SCREEN 3
	IF TRUE
	THEN
		SET TILE (10, 5) = 34
		SET TILE (10, 6) = 35
		SET TILE (2, 2) = 20
		SET TILE (12, 2) = 21
		SET TILE (6, 1) = 44
		SET TILE (7, 1) = 45
		SET TILE (8, 1) = 46
		SET TILE (7, 4) = 16
		SET FLAG 3 = 0
		SET FLAG 6 = 1
	END

	IF FLAG 2 = 0
	THEN
		SET FIRE ZONE 58, 0, 139, 239
	END

	IF FLAG 2 = 1
	THEN
		SET FIRE ZONE 97, 49, 127, 79
	END
END

PRESS FIRE AT SCREEN 3
	IF PLAYER NEAR 10, 6
	IF FLAG 5 = 6
	THEN
		TEXT BOX "WALKER: TE QUEDA POCO TIEMPO..."
		REENTER
	END

	IF PLAYER NEAR 10, 6
	IF FLAG 5 = 5
	THEN
		SET FLAG 5 = 6
		TEXT BOX "WALKER: ERES INSISTENTE Y PARECES NO TENER MIEDO A LA MUERTE. ME GUSTAS, CHICO. HUELE MI ALIENTO: TE DARA UNA VIDA EXTRA!"
		INC LIFE, 1
		SOUND 20
		REENTER
	END

	IF PLAYER NEAR 10, 6
	IF FLAG 5 > 1
	IF FLAG 5 < 5
	THEN
		INC $5, 1
		TEXT BOX "WALKER: TE QUEDA POCO TIEMPO..."
		REENTER
	END

	IF PLAYER NEAR 10, 6
	IF FLAG 5 = 1
	THEN
		SET FLAG 5 = 2
		TEXT BOX "WALKER: EN ESTA TIENDA HAY 1254 OBJETOS QUE PUEDO USAR PARA MATARTE... INCLUIDA LA PROPIA TIENDA."
		REENTER
	END

	IF PLAYER NEAR 10, 6
	IF FLAG 5 = 0
	THEN
		MUSIC 18
		SET FLAG 5 = 1
		TEXT BOX "WALKER: MI NOMBRE ES WALKER, TEXAS RANGER Y FALTAN DOS SEGUNDOS..."
		TEXT BOX "WALKER: QUE DOS SEGUNDOS PARA QUE? PARA DARTE UNA PATADA GIRATORIA EN LA CARA, ASI QUE COMPRA RAPIDITO."
		REENTER
	END

	IF FLAG 2 = 0
	THEN
		SET FLAG 2 = 1
		TEXT BOX "WALKER: BIENVENIDO A MI TIENDA. PUEDES COMPRAR VIDAS A 20 MONEDAS."
		REENTER
	END

	IF PLAYER NEAR 7, 4
	IF FLAG 1 < #4
	THEN
		TEXT BOX "WALKER: NO TE QUEDAN PASTA, COWBOY, VUELVE CON TUS VACAS"
		SET FLAG 3 = 1
		PY = 80
		REENTER
	END

	IF PLAYER NEAR 7, 4
	IF FLAG 3 = 0
	THEN
		TEXT BOX "WALKER: BUENA ELECCION, COWBOY."
		DEC FLAG 1, #4
		INC LIFE, 1
		SOUND 20
		PY = 80
		REENTER
	END
END

ENTERING SCREEN 5
	IF TRUE
	THEN
		SET TILE (10, 5) = 36
		SET TILE (10, 6) = 37
		SET TILE (2, 2) = 20
		SET TILE (12, 2) = 21
		SET TILE (6, 1) = 44
		SET TILE (7, 1) = 45
		SET TILE (8, 1) = 46
		SET TILE (7, 4) = 16
		SET FLAG 3 = 0
		SET FLAG 6 = 1
	END

	IF FLAG 2 = 0
	THEN
		SET FIRE ZONE 58, 0, 139, 239
	END

	IF FLAG 2 = 1
	THEN
		SET FIRE ZONE 97, 49, 127, 79
	END
END

PRESS FIRE AT SCREEN 5
	IF PLAYER NEAR 10, 6
	IF FLAG 5 = 5
	THEN
		TEXT BOX "BUD SPENCER: BOM BOBOBOM BOBOBOM..."
		REENTER
	END

	IF PLAYER NEAR 10, 6
	IF FLAG 5 = 4
	THEN
		SET FLAG 5 = 5
		TEXT BOX "BUD SPENCER: DE MOMENTO NO TE VOY A MATAR PORQUE PUEDO NECESITARTE... COMO MUCHO. TOMA, UNA VIDA EXTRA"
		INC LIFE, 1
		SOUND 20
		REENTER
	END

	IF PLAYER NEAR 10, 6
	IF FLAG 5 = 3
	THEN
		SET FLAG 5 = 4
		TEXT BOX "BUD SPENCER: SIEMPRE QUE HAY QUE DECIDIR ALGO ME LO JUEGO A CERVEZA Y SALCHICHA."
		REENTER
	END

	IF PLAYER NEAR 10, 6
	IF FLAG 5 = 2
	THEN
		SET FLAG 5 = 3
		TEXT BOX "BUD SPENCER: DIOS PERDONA... YO NO."
		REENTER
	END

	IF PLAYER NEAR 10, 6
	IF FLAG 5 = 1
	THEN
		SET FLAG 5 = 2
		TEXT BOX "BUD SPENCER: NO HAY MALO MAS MALO QUE EL BUENO QUE SE CONVIERTE EN MALO. YA LO SABES."
		REENTER
	END

	IF PLAYER NEAR 10, 6
	IF FLAG 5 = 0
	THEN
		MUSIC 12
		SET FLAG 5 = 1
		TEXT BOX "BUD SPENCER: ESTOY ENFADADO PORQUE NO ME DEVUELVEN MI COCHECITO"
		REENTER
	END

	IF FLAG 2 = 0
	THEN
		SET FLAG 2 = 1
		TEXT BOX "BUD SPENCER: TU, LAS VIDAS SON A 25 MONEDAS. COMPRA, O SI NO, NOS ENFADAMOS."
		REENTER
	END

	IF PLAYER NEAR 7, 4
	IF FLAG 1 < #4
	THEN
		TEXT BOX "BUD SPENCER: NO TE QUEDA DINERO, HUYE DE AQUI SI NO QUIERES QUE TE SUELTE UNA CON LA MANO ABIERTA"
		SET FLAG 3 = 1
		PY = 80
		REENTER
	END

	IF PLAYER NEAR 7, 4
	IF FLAG 3 = 0
	THEN
		TEXT BOX "BUD SPENCER: ASI ME GUSTA, CHIQUITIN"
		DEC FLAG 1, #4
		INC LIFE, 1
		SOUND 20
		PY = 80
		REENTER
	END
END

ENTERING SCREEN 7
	IF TRUE
	THEN
		SET TILE (10, 5) = 38
		SET TILE (10, 6) = 39
		SET TILE (2, 2) = 20
		SET TILE (12, 2) = 21
		SET TILE (6, 1) = 44
		SET TILE (7, 1) = 45
		SET TILE (8, 1) = 46
		SET TILE (7, 4) = 16
