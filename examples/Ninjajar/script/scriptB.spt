		SET FLAG 6 = 1
	END

	IF FLAG 2 = 0
	THEN
		SET FIRE ZONE 58, 0, 139, 239
	END

	IF FLAG 2 = 1
	THEN
		SET FIRE ZONE 97, 49, 127, 79
	END
END

PRESS FIRE AT SCREEN 7
	IF PLAYER NEAR 10, 6
	IF FLAG 5 = 5
	THEN
		TEXT BOX "CHUCK: YO NO DUERMO, ESPERO..."
		REENTER
	END

	IF PLAYER NEAR 10, 6
	IF FLAG 5 = 4
	THEN
		SET FLAG 5 = 5
		TEXT BOX "CHUCK: AUN SIGUES VIVO? ESO DEMUESTRA QUE CONTROLAS EL ARTE DE LA PATADA GIRATORIA. TOMA, UNA VIDA EXTRA"
		INC LIFE, 1
		SOUND 20
		REENTER
	END

	IF PLAYER NEAR 10, 6
	IF FLAG 5 = 3
	THEN
		SET FLAG 5 = 4
		TEXT BOX "CHUCK: ANTES DE AQUEL A<O QUE OLVIDO TRAERME UN REGALO POR NAVIDAD, PAPA NOEL EXISTIA."
		REENTER
	END

	IF PLAYER NEAR 10, 6
	IF FLAG 5 = 2
	THEN
		SET FLAG 5 = 3
		TEXT BOX "CHUCK: 2 MAS 2 = VIOLENCIA. YO SOLUCIONO TODOS LOS PROBLEMAS CON LA VIOLENCIA."
		REENTER
	END

	IF PLAYER NEAR 10, 6
	IF FLAG 5 = 1
	THEN
		SET FLAG 5 = 2
		TEXT BOX "CHUCK: MI VOZ NO PRODUCE ECO. PORQUE NADIE TIENE LOS COJONES DE CONTESTAR A CHUCK NORRIS."
		REENTER
	END

	IF PLAYER NEAR 10, 6
	IF FLAG 5 = 0
	THEN
		MUSIC 16
		SET FLAG 5 = 1
		TEXT BOX "CHUCK: CUANDO SUBO AL ASCENSOR NO PULSO NINGUN BOTON. MAS LE VALE AL JODIDO APARATO SABER ADONDE QUIERO IR!"
		REENTER
	END

	#;

	IF FLAG 2 = 0
	THEN
		SET FLAG 2 = 1
		TEXT BOX "CHUCK: HOLA, SOY CHUCK NORRIS Y VENDO DOLOR. A 25 MONEDAS."
		TEXT BOX "CHUCK: QUE ME HAS VISTO ANTES EN OTRA TIENDA? CALLA O TENDRAS QUE ESCONDERTE DE MI COMO WALLY!"
		REENTER
	END

	IF PLAYER NEAR 7, 4
	IF FLAG 1 < #4
	THEN
		TEXT BOX "CHUCK: NO TE QUEDA PASTA. DESAPARECE ANTES DE QUE PIENSE EN TU MUERTE, PUES MORIRAS AL INSTANTE"
		SET FLAG 3 = 1
		PY = 80
		REENTER
	END

	IF PLAYER NEAR 7, 4
	IF FLAG 3 = 0
	THEN
		TEXT BOX "CHUCK: SON 20 MONEDAS"
		DEC FLAG 1, #4
		INC LIFE, 1
		SOUND 20
		PY = 80
		REENTER
	END
END

# Alex

ENTERING SCREEN 9
	IF TRUE
	THEN
		SET TILE (10, 5) = 40
		SET TILE (10, 6) = 41
		SET TILE (2, 2) = 20
		SET TILE (12, 2) = 21
		SET TILE (6, 1) = 44
		SET TILE (7, 1) = 45
		SET TILE (8, 1) = 46
		SET TILE (8, 4) = 16
		SET TILE (6, 4) = 22
		SET TILE (7, 4) = 23
		SET FLAG 3 = 0
		SET FLAG 6 = 1
	END

	IF FLAG 2 = 0
	THEN
		SET FIRE ZONE 58, 0, 139, 239
	END

	IF FLAG 2 = 1
	THEN
		SET FIRE ZONE 81, 49, 143, 79
	END
END

PRESS FIRE AT SCREEN 9
	IF PLAYER NEAR 10, 6
	IF FLAG 5 = 5
	THEN
		TEXT BOX "ALEX: TANA NANA, TANA NANA... PIPU PIPU PIUUU"
		REENTER
	END

	IF PLAYER NEAR 10, 6
	IF FLAG 5 = 4
	THEN
		SET FLAG 5 = 5
		TEXT BOX "ALEX: DEJA EL LISTON BIEN ALTO! TOMA, UNA VIDA EXTRA!"
		INC LIFE, 1
		SOUND 20
		REENTER
	END

	IF PLAYER NEAR 10, 6
	IF FLAG 5 = 3
	THEN
		SET FLAG 5 = 4
		TEXT BOX "ALEX: ERES UN COPIOTA PLAGIADOR! PERO ME CAES BIEN, YO TAMBIEN ME VESTI DE NINJA PARA CATAR TOTETE EN UNA OCASION."
		REENTER
	END

	IF PLAYER NEAR 10, 6
	IF FLAG 5 = 2
	THEN
		SET FLAG 5 = 3
		TEXT BOX "ALEX: SOY EL REY DE LAS PANDILLAS: ME PUEDEN APODAR ;EL CHINO;, ;EL OREJA; Y ;EL CABESA;."
		REENTER
	END

	IF PLAYER NEAR 10, 6
	IF FLAG 5 = 1
	THEN
		SET FLAG 5 = 2
		TEXT BOX "ALEX: JUGARIA CONTIGO UNAS PARTIDAS DE JANKENPON, PERO ME HA SALIDO UN PADRASTRO EN EL DEO"
		REENTER
	END

	IF PLAYER NEAR 10, 6
	IF FLAG 5 = 0
	THEN
		MUSIC 13
		SET FLAG 5 = 1
		TEXT BOX "ALEX: SI, DESDE QUE LLEGO EL ERIZO AZUL LA COSA ESTA BASTANTE MALA... HE TENIDO QUE ABRIR UNA TIENDA CUTRE."
		REENTER
	END

	#;

	IF FLAG 2 = 0
	THEN
		SET FLAG 2 = 1
		TEXT BOX "ALEX: BIENVENIDO A MI TIENDA. TENGO VIDAS FRESCAS A 30 MONEDAS, Y UNA MOTO SEMINUEVA"
		REENTER
	END

	IF PLAYER NEAR 8, 4
	IF FLAG 1 < #4
	THEN
		TEXT BOX "ALEX: NO TE QUEDA DINERO, Y EN RADAXIAN NO SE FIA!"
		SET FLAG 3 = 1
		PY = 80
		REENTER
	END

	IF PLAYER NEAR 8, 4
	IF FLAG 3 = 0
	THEN
		TEXT BOX "ALEX: GRACIAS!"
		DEC FLAG 1, #4
		INC LIFE, 1
		SOUND 20
		PY = 80
		REENTER
	END

	IF PLAYER NEAR 6, 4
	THEN
		TEXT BOX "ALEX: LA MOTO SON 5000 MONEDAS, NO TIENES SUFICIENTE. NO ES NADA CARA, SI ESTA SEMINUEVA!"
		PY = 80
		REENTER
	END
END

ENTERING SCREEN 10
	IF TRUE
	THEN
		SET TILE (10, 7) = 42
	END
END

PRESS FIRE AT SCREEN 10
	IF PLAYER NEAR 10, 7
	THEN
		TEXT BOX "GENIO: ESTA ES LA ENCRUCIJADA FINAL. IRAS AL CASTILLO CHUNGO A POR TU CHICA, O PASARAS DE ELLA Y TE IRAS TU SOLO A PEPINONI?"
		REENTER
	END
END

ENTERING SCREEN 11
	IF TRUE
	THEN
		SET TILE (2, 5) = 24
		SET TILE (5, 3) = 18
		SET TILE (4, 7) = 18
		SET FIRE ZONE 224, 0, 239, 159
	END
END

PRESS FIRE AT SCREEN 11
	IF PLAYER NEAR 2, 5
	THEN
		TEXT BOX "CARTEL: POR ARRIBA: AL CASTILLO DEL MONO CHUNGO. POR ABAJO: DIRECTO A LA PLAYA DE PEPINONI"
		REENTER
	END

	IF PLAYER NEAR 5, 3
	THEN
		TEXT BOX "CARTEL: AL CASTILLO DEL MONO CHUNGO"
		REENTER
	END

	IF PLAYER NEAR 4, 7
	THEN
		TEXT BOX "CARTEL: A LA PLAYA DE PEPINONI"
		REENTER
	END

	IF PLAYER NEAR 14, 3
	THEN
		WARP TO LEVEL 22, 15, 7, 7, 0
	END

	IF PLAYER NEAR 14, 7
	THEN
		WARP TO LEVEL 21, 0, 1, 1, 0
	END
END
