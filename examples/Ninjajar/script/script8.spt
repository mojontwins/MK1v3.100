# Ninjajar - Nivel 5: la isla de la bruja Sarollán (mapa 8)
# Convertido del script original de 2014 (msc3) a msc4.

ROOMS = 21
TEXT WIDTH = 24


##############################################################################
# Level 5 : ISLA SAROLLÁN
##############################################################################

# Flag 2: piedras aparecen en pantalla 10
# Flag 3: fijar piedras pantalla 10
# Flag 4: Bruce:
# 		- 0, inicial. Rollo camwars -> 1
#		- 1, respuesta genérica qué quelel.
#		- 2, Cuando ha examinado la chimenea y queremos cepillo
#			Flag 5 == 0? Solo acepta dinero chino.
#			Flag 5 == 1? -> 3 (le da el cepillo)
#		- 3, Ya tenemos el cepillo. Respuesta genérica "buen día"
# Flag 5: Dinero chino
# Flag 6: TV

## Modificación: Buscar alguna pantalla donde ocultar el sostén!

ENTERING GAME
	IF TRUE
	THEN
		SET FLAG 2 = 0
		SET FLAG 3 = 0
		SET FLAG 4 = 0
		SET FLAG 5 = 0
		SET FLAG 6 = 0
	END
END

# Casa de la bruja Sarollán (fuera)
ENTERING SCREEN 1
	IF TRUE
	THEN
		SET TILE (12, 6) = 38
		SET TILE (11, 7) = 35
		SET TILE (12, 7) = 36
		SET TILE (13, 7) = 37
		SET TILE (11, 8) = 32
		SET TILE (12, 8) = 33
		SET TILE (13, 8) = 34
		SET TILE (2, 7) = 29
		SET TILE (3, 7) = 30
		SET TILE (4, 6) = 29
		SET TILE (7, 8) = 30

		# Secreto! Ocultar tiles traspasables
		PRINT TILE (28, 2) = 5
		PRINT TILE (28, 4) = 10
	END
END

PRESS FIRE AT SCREEN 1
	IF PLAYER NEAR 13, 8
	THEN
		TEXT BOX "LA PUERTA ESTA CERRADA, Y POR MAS QUE LLAMO NO ABREN. DENTRO SE OYE LA TELE MUY FUERTE. TENGO QUE ENCONTRAR OTRA FORMA DE ENTRAR"
		REENTER
	END

	IF PLAYER NEAR 12, 5
	IF FLAG 4 < 3
	THEN
		SET FLAG 4 = 2
		TEXT BOX "PODRIA COLARME POR AQUI, PERO LA CHIMENEA TIENE MAS MIERDA QUE LA BOMBILLA DE UNA CUADRA. NECESITO ALGO PARA LIMPIARLA."
		REENTER
	END

	IF PLAYER NEAR 12, 5
	IF FLAG 4 = 3
	THEN
		TEXT BOX "CREO QUE PODRE LIMPIAR LA CHIMENEA CON ESTE CEPILLO DE LIMPIAR CHIMENEAS... PERFECTO! ADENTRO!"
		SET FLAG 4 = 4
		EXTERN 5, 47
	END

	IF PLAYER NEAR 12, 5
	IF FLAG 4 = 4
	THEN
		EXTERN 0
		MUSIC 6
		WARP TO 15, 5, 3
	END
END

# Sostén
ENTERING SCREEN 4
	IF FLAG 31 = 0
	THEN
		SET TILE (6, 2) = 17
		SET FIRE ZONE 81, 17, 111, 47
	END
END

PRESS FIRE AT SCREEN 4
	IF FLAG 31 = 0
	IF PLAYER NEAR 6, 2
	THEN
		SET TILE (6, 2) = 15
		SOUND 20
		EXTERN 6, 17
		SET FLAG 31 = 1
	END
END

# Zunda Zunda
ENTERING SCREEN 6
	IF TRUE
	THEN
		SET TILE (11, 4) = 23
		SET FIRE ZONE 16, 0, 143, 239
	END
END

PRESS FIRE AT SCREEN 6
	# General speech
	IF PLAYER NEAR 2, 1
	THEN
		TEXT BOX "GENIO: RECUERDA ESTO: A LA ENTRADA DEL CASTILLO HAY QUE CONTEMPLAR LAS COLUMNAS EN ORDEN Y SE ABRIRA LA PUERTA."
		# REPOSTN se llama más tarde. Esto es un hack!
	END

	# Present
	IF PLAYER NEAR 2, 1
	IF FLAG 31 = 1
	THEN
		SET FLAG 31 = 2
		TEXT BOX "GENIO: OOOOH! VEO QUE ME TRAES OTRO PRESENTE! UN BONITO SOSTEN! CHICO, ME ESTAS EMPEZANDO A CAER MUY BIEN. TOMA UNA AYUDA..."
		EXTERN 6, 47
		INC LIFE, 5
		SOUND 20
		#REPOSTN 1, 1
		PX = 16
		REENTER
	END

	IF PLAYER NEAR 2, 1
	THEN
		#REPOSTN 1, 1
		PX = 16
		REENTER
	END
END

ENTERING SCREEN 7
	IF TRUE
	THEN
		SET TILE (5, 8) = 24
		SET TILE (11, 7) = 30
		SET TILE (9, 8) = 29
		SET TILE (6, 8) = 29
		SET TILE (7, 8) = 46
		SET TILE (8, 8) = 30
		SET TILE (1, 8) = 30
	END
END

PRESS FIRE AT SCREEN 7
	IF PLAYER NEAR 5, 8
	THEN
		TEXT BOX "CARTEL: HACIA ARRIBA, LA CASA DE LA ILUSTRISIMA BRUJA SAROLLAN"
		REENTER
	END
END

ENTERING SCREEN 8
	IF TRUE
	THEN
		SET TILE (1, 8) = 29
		SET TILE (2, 8) = 46
		SET TILE (3, 8) = 46
		SET TILE (4, 8) = 30
	END
END

# Al entrar en la pantalla 9 "fijamos" las piedras.
ENTERING SCREEN 9
	IF TRUE
	THEN
		SET FLAG 3 = 1
	END
END

# Rocas fantasma
ENTERING SCREEN 10
	IF TRUE
	THEN
		SET TILE (3, 3) = 25
		SET TILE (6, 3) = 25
		SET TILE (9, 3) = 26
		SET TILE (2, 2) = 29
		SET TILE (3, 2) = 30

		SET FIRE ZONE 129, 32, 159, 47
		SET FLAG 2 = 0
	END

	IF FLAG 3 = 1
	THEN
		SET TILE (4, 8) = 13
		SET TILE (9, 8) = 13
		SET FLAG 2 = 1
	END
END

PRESS FIRE AT SCREEN 10
	IF PLAYER NEAR 3, 2
	THEN
		SET TILE (4, 8) = 13
		SET FLAG 2 = 1
		SOUND 16
	END

	IF PLAYER NEAR 6, 2
	THEN
		SET TILE (9, 8) = 13
		SET FLAG 2 = 1
		SOUND 16
	END

	IF PLAYER NEAR 9, 2
	IF FLAG 2 = 1
	THEN
		SET FLAG 2 = 0
		SET TILE (4, 8) = 0
		SET TILE (9, 8) = 0
		SOUND 22
	END
END

# Decorations
ENTERING SCREEN 11
	IF TRUE
	THEN
		SET TILE (13, 7) = 29
		SET TILE (12, 8) = 29
		SET TILE (1, 8) = 29
		SET TILE (2, 8) = 30
	END
END

# Cartel tienda bruce
ENTERING SCREEN 12
	IF TRUE
	THEN
		SET TILE (8, 8) = 24
		SET TILE (3, 1) = 24
		SET TILE (12, 8) = 46
		SET TILE (8, 8) = 29
		SET TILE (9, 7) = 29
		SET TILE (10, 7) = 46
		SET TILE (11, 7) = 30
		SET TILE (5, 4) = 30
		SET TILE (1, 4) = 29
	END
END

PRESS FIRE AT SCREEN 12
	IF PLAYER NEAR 8, 8
	THEN
		TEXT BOX "CARTEL: ACCESO A LA TIENDA DEL CHINO BRUCE. TENEMOS DE TODO!"
		REENTER
	END

	IF PLAYER NEAR 3, 1
	THEN
		TEXT BOX "CARTEL: ARRIBA, EN LAS NUBES, EL GRAN GENIO ZUNDA ZUNDA - RESIDENCIA DE VERANO"
		REENTER
	END
END

# Pantalla inicial
ENTERING SCREEN 13
	IF TRUE
	THEN
		SET TILE (13, 9) = 18
		SET TILE (14, 9) = 18
		SET TILE (9, 7) = 24
		SET TILE (11, 8) = 29
		SET TILE (12, 8) = 30
		SET TILE (8, 8) = 46
		SET TILE (5, 7) = 29
		SET TILE (1, 8) = 29
		SET TILE (2, 8) = 46
	END
END

PRESS FIRE AT SCREEN 13
	IF PLAYER NEAR 9, 7
	THEN
		TEXT BOX "CARTEL: ISLA DE LA BRUJA SAROLLAN"
		REENTER
	END
END

# Casa de bruce (dentro)
ENTERING SCREEN 14
	IF TRUE
	THEN
		SET TILE (10, 2) = 43
		SET TILE (11, 2) = 44
		SET TILE (4, 6) = 28
		SET TILE (5, 6) = 41
		SET TILE (6, 6) = 42
		SET TILE (1, 6) = 29
		SET TILE (2, 6) = 30
		SET TILE (12, 6) = 29
		SET TILE (13, 6) = 46
		SET TILE (14, 6) = 30
		SET FIRE ZONE 174, 0, 239, 143
	END
END

PRESS FIRE AT SCREEN 14
	IF PLAYER NEAR 11, 6
	THEN
		EXTERN 0
		MUSIC 0
		WARP TO 20, 9, 5
	END

	IF PLAYER NEAR 5, 6
	IF FLAG 4 > 2
	THEN
		TEXT BOX "BRUCE: QUE QUELEL? NADA? POS NADA. A CASCAL."
		REENTER
	END

	IF PLAYER NEAR 5, 6
	IF FLAG 4 = 2
	IF FLAG 5 = 0
	THEN
		TEXT BOX "BRUCE: UN CEPILLO DE LIMPIAL CHIMENEA? SI TENEL, PERO SOLO ACEPTAL DINELO CHINO. Y TU NO TENEL."
		REENTER
	END

	IF PLAYER NEAR 5, 6
	IF FLAG 4 = 2
	IF FLAG 5 = 1
	THEN
		TEXT BOX "BRUCE: UN CEPILLO DE LIMPIAL CHIMENEA? VALE UN YUAN. AQUI TENEL. GLACIAS."
		SET FLAG 4 = 3
		SET FLAG 5 = 2
		EXTERN 5, 45
		REENTER
	END

	IF PLAYER NEAR 5, 6
	IF FLAG 4 = 1
	THEN
		TEXT BOX "BRUCE: QUE QUELEL? NADA? POS NADA. A CASCAL."
		REENTER
	END

	IF PLAYER NEAR 5, 6
	IF FLAG 4 = 0
	THEN
		TEXT BOX "BRUCE: HOLA, ESTO ES LA TIENDA LEE. QUE QUELEL?"
		TEXT BOX "NINJAJAR: TIENE USTED FUEGOS QUE NO QUEMAN?"
		TEXT BOX "BRUCE: HUM! NO TENEL! IBA A LLAMAL AL PLOVEEDOL PELO SE ME LOMPIO LA VOZ DE OTLO MUNDO."
		TEXT BOX "BRUCE: SI QUIELES ESPELAL, PUEDES SENTALTE AHI A MILAL EL ESPEJO DE LA SABIDULIA MIENTLAS TE TOMAS UN ELIXIL DE LA VIDA."
		REDRAW
		SET TILE (10, 2) = 43
		SET TILE (11, 2) = 44
		SET TILE (4, 6) = 28
		SET TILE (5, 6) = 41
		SET TILE (6, 6) = 42
		TEXT BOX "NINJAJAR: MEJOR DEJALO..."
		TEXT BOX "BRUCE: HASTA LA PLOXIMA."
		SET FLAG 4 = 1
		REENTER
	END
END

# Casa de la bruja Sarollán (dentro)
ENTERING SCREEN 15
	IF TRUE
	THEN
		SET TILE (4, 6) = 27
		SET TILE (7, 6) = 39
		SET TILE (9, 6) = 40
		SET TILE (5, 2) = 38
		SET FIRE ZONE 0, 0, 239, 47
		SET TILE (0, 6) = 29
		SET TILE (1, 6) = 46
		SET TILE (2, 6) = 30
		SET TILE (12, 6) = 30
	END
END

PRESS FIRE AT SCREEN 15
	IF PLAYER NEAR 5, 2
	THEN
		EXTERN 0
		MUSIC 0
		WARP TO 1, 12, 5
	END

	# TV, flag 6 = 0 encendida.
	IF PLAYER NEAR 9, 6
	IF FLAG 6 = 0
	THEN
		SET FLAG 6 = 1
		TEXT BOX "HE APAGADO LA TELE"
		REENTER
	END

	# Hablar con la bruja
	IF PLAYER NEAR 7, 6
	IF FLAG 6 = 0
	THEN
		TEXT BOX "SAROLLAN: NO ME ENTERO DE NADA DE LO QUE DICES! LA TELE ESTA ALTISIMA!"
		REENTER
	END

	IF PLAYER NEAR 7, 6
	IF FLAG 6 = 1
	THEN
		TEXT BOX "SAROLLAN: COMPRENDO. A TU NOVIA SE LA HA LLEVADO UN MONO SALIDO Y NO SABES ADONDE SE LA HA LLEVADO."
		TEXT BOX "SAROLLAN: NO TE PREOCUPES. LO MIRARE EN MI BOLA DE MIRAR COSAS. DEJAME QUE ME CONCENTRE... OOOOHM..."
		TEXT BOX "SAROLLAN: AQUI ESTA. LO VEO. UN MONO SALIDO. EN EL CASTILLO DE LA CARNE DE MEMBRILLO! NO ESTA LEJOS."
		TEXT BOX "SAROLLAN: RAPIDO, NINJAJAR, PONTE EN CAMINO! CONOZCO A ESE MONO Y ES TELA DE CHUNGO! CORRE, NINJAJAR!"
		EXTERN 0
		WIN GAME
	END
END

ENTERING SCREEN 16
	IF TRUE
	THEN
		SET TILE (4, 0) = 29
		SET TILE (8, 7) = 29
		SET TILE (9, 6) = 29
		SET TILE (10, 6) = 30
		SET TILE (11, 8) = 30
	END
END

ENTERING SCREEN 17
	IF TRUE
	THEN
		SET TILE (2, 8) = 29
		SET TILE (4, 6) = 29
		SET TILE (5, 6) = 30
		SET TILE (12, 8) = 30
	END
END

# Moneda china
ENTERING SCREEN 18
	IF TRUE
	THEN
		SET TILE (13, 0) = 30
		SET TILE (14, 1) = 46
	END

	IF FLAG 5 = 0
	THEN
		SET TILE (10, 7) = 21
		SET FIRE ZONE 145, 97, 175, 127
	END
END

PRESS FIRE AT SCREEN 18
	IF FLAG 5 = 0
	IF PLAYER NEAR 10, 7
	THEN
		SET FLAG 5 = 1
		TEXT BOX "UNA MONEDA CHINA. ME LA GUARDO."
		EXTERN 5, 21
		REDRAW
	END
END

# Casa de bruce (Fuera)
ENTERING SCREEN 20
	IF TRUE
	THEN
		SET TILE (8, 3) = 43
		SET TILE (9, 3) = 44
		SET TILE (7, 4) = 35
		SET TILE (8, 4) = 36
		SET TILE (9, 4) = 37
		SET TILE (7, 5) = 32
		SET TILE (8, 5) = 33
		SET TILE (9, 5) = 20
		SET TILE (12, 0) = 46
	END
END

PRESS FIRE AT SCREEN 20
	IF PLAYER NEAR 9, 5
	THEN
		EXTERN 0
		MUSIC 20
		WARP TO 14, 10, 6
	END
END
