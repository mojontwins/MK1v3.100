# Ninjajar - Nivel 0: la intro (mapa 5)
# Convertido del script original de 2014 (msc3) a msc4.

ROOMS = 21
TEXT WIDTH = 24

# Ninjajar
# Copyleft 2014 Mojontwins
# Churrera 5

# Flags globales
# FLAG 28 : Final bueno / final malo
# FLAG 29 :
# FLAG 30 :
# FLAG 31 :

##############################################################################
# LEVEL 0
##############################################################################

# flags:
# 2	- Estado general
# 3 - Tiene las bragas
# 4 - Tiene la bomba
# 5 - 1=Hablado con genio, 2=Dado bragas
# 6 - Buchu
# 7 - Examinar bloqueo
# 8 - Aprendiz de mago
# 9 - Acertijo de la cueva
# 11 - Aparición de la varita (corrige un bug)

ENTERING GAME
	IF TRUE
	THEN
		SET FLAG 2 = 0
		SET FLAG 3 = 0
		SET FLAG 4 = 0
		SET FLAG 5 = 0
		SET FLAG 6 = 0
		SET FLAG 7 = 0
		SET FLAG 8 = 0
		SET FLAG 9 = 0
		SET FLAG 10 = 0
	END
END

ENTERING SCREEN 0
	IF TRUE
	THEN
		SET TILE (2, 5) = 23
		SET FIRE ZONE 0, 0, 144, 159
	END
END

PRESS FIRE AT SCREEN 0
	IF FLAG 3 = 0
	IF PLAYER NEAR 8, 6
	THEN
		SET FLAG 5 = 1
		TEXT BOX "GENIO: SOY ZUNDA ZUNDA, GENIO DE LA TORMENTA. COMO OSAS VENIR SIN UN PRESENTE? VAMOS, FUERA! RAPIDO!"
		#REPOSTN 9, 6
		PX = 144
		REENTER
	END

	IF FLAG 3 = 1
	IF PLAYER NEAR 8, 6
	THEN
		TEXT BOX "GENIO: OOH! TAN DELICIOSAS! VETE A LA BARRERA Y PON LA BOMBA, QUE YO TE PRESTO UN RAYO DE LOS MIOS... JE, JE, COMO MOLAN..."
		EXTERN 4, 47
		SET FLAG 3 = 2
		SET FLAG 5 = 2
		#REPOSTN 9, 6
		PX = 144
		REENTER
	END

	IF FLAG 3 = 2
	IF PLAYER NEAR 8, 6
	THEN
		TEXT BOX "GENIO: JE, JE, JE, COMO MOLAN!"
		#REPOSTN 9, 6
		PX = 144
		REENTER
	END
END

ENTERING SCREEN 3
	IF TRUE
	THEN
		SET TILE (7, 4) = 18
		SET TILE (8, 4) = 20
		SET TILE (7, 5) = 45
		SET TILE (8, 5) = 46
		SET TILE (2, 9) = 17
		SET TILE (3, 8) = 17
		SET TILE (11, 8) = 21
		SET TILE (12, 9) = 21
	END
END

PRESS FIRE AT SCREEN 3
	IF FLAG 6 = 0
	THEN
		SET FLAG 6 = 1
		TEXT BOX "BUCHU: MI FILOSOFIA SE BASA EN EL ZEN Y SOY SEGUIDOR DEL TAO. POR ESO CUANDO NO ENTRENO ESTOY SIEMPRE ZENTAO"
		TEXT BOX "BUCHU: Y COMO COMPENSACION POR UN CHISTE TAN MALO, TE VOY A REGALAR UNAS CUANTAS VIDAS EXTRA. COMO MOLO, EH?"
		INC LIFE, 3
		SOUND 20
		REENTER
	END
END

ENTERING SCREEN 7
	IF TRUE
	THEN
		SET TILE (2, 6) = 34
		SET TILE (3, 6) = 35
		SET TILE (2, 7) = 32
		SET TILE (3, 7) = 33
	END
END

PRESS FIRE AT SCREEN 7
	IF PLAYER NEAR 3, 7
	THEN
		EXTERN 0
		MUSIC 6
		WARP TO 14, 3, 7
	END
END

ENTERING SCREEN 8
	IF FLAG 5 <> 3
	THEN
		SET TILE (14, 6) = 27
		SET TILE (14, 7) = 28
		SET FIRE ZONE 193, 97, 224, 128
	END

	IF FLAG 2 <> 0
	THEN
		SET TILE (4, 8) = 0
		SET TILE (5, 8) = 0
	END

	IF TRUE
	THEN
		SET TILE (3, 8) = 21
		SET TILE (6, 8) = 17
	END

	IF FLAG 10 = 0
	THEN
		SET FIRE ZONE 0, 0, 239, 159
	END
END

PRESS FIRE AT SCREEN 8
	IF FLAG 10 = 0
	THEN
		SET FLAG 10 = 1
		TEXT BOX "NINJAJAR LLEGA A LA ENTRADA DE SU PUEBLO, PERO SE ENCUENTRA UNA IMPROVISADA BARRERA EN LA PUERTA."
		REENTER
	END

	IF PLAYER NEAR 13, 7
	IF FLAG 5 < 2
	IF FLAG 2 = 0
	THEN
		TEXT BOX "EH?!! PERO POR QUE HAN TAPONADO LA ENTRADA DEL PUEBLO? NO PODRE IR A VER A MI CHICA SI NO ME ENCARGO DE LIBRARME DE ESTO."
		#REPOSTN 12, 7
		PX = 192
		REENTER
	END

	IF PLAYER NEAR 13, 7
	IF FLAG 5 < 2
	IF FLAG 4 = 1
	THEN
		TEXT BOX "NO HAY NADA QUE HACER. SIN MECHA NO PUEDO HACER EXPLOTAR LA BOMBA."
		#REPOSTN 12, 7
		PX = 192
		REENTER
	END

	IF PLAYER NEAR 13, 7
	IF FLAG 5 = 2
	THEN
		EXTERN 5, 47
		SET TILE (13, 7) = 25
		SOUND 15
		PAUSE 15
		TEXT BOX "GENIO: DE ACUERDO, NINJAJAR! ALLA VA MI SUPER MEGA HIPER RAYO DE PODEWWWR!!"
		SET TILE (13, 6) = 29
		SHOW
		SOUND 23
		PAUSE 8
		SET TILE (13, 7) = 30
		SHOW
		SOUND 23
		PAUSE 15
		SET TILE (13, 6) = 0
		SET TILE (14, 6) = 30
		SET TILE (14, 7) = 30
		SHOW
		SOUND 23
		PAUSE 20
		SET FLAG 5 = 3
		REENTER
	END
END

ENTERING SCREEN 10
	IF TRUE
	THEN
		SET TILE (5, 7) = 42
		SET TILE (1, 8) = 21
		SET TILE (4, 9) = 17
		SET TILE (5, 8) = 17
		SET TILE (10, 8) = 21
		SET TILE (13, 8) = 17
	END

	IF FLAG 8 = 0
	THEN
		SET TILE (2, 8) = 8
		SET TILE (3, 8) = 8
		SET TILE (4, 8) = 8
	END
END

PRESS FIRE AT SCREEN 10
	IF PLAYER NEAR 5, 7
	THEN
		TEXT BOX "CARTEL: CUEVA DE LOS ACERTIJOS, PROPIEDAD DEL MAGUFO DEL PUFO"
		REENTER
	END
END

ENTERING SCREEN 11
	IF TRUE
	THEN
		SET TILE (6, 6) = 34
		SET TILE (7, 6) = 35
		SET TILE (6, 7) = 32
		SET TILE (7, 7) = 33
	END
END

PRESS FIRE AT SCREEN 11
	IF PLAYER NEAR 7, 7
	THEN
		EXTERN 0
		MUSIC 6
		WARP TO 19, 12, 7
	END
END

ENTERING SCREEN 12
	IF FLAG 8 = 3
	THEN
		SET TILE (4, 8) = 8
		SET TILE (7, 8) = 8
		SET TILE (10, 8) = 8
	END

	IF TRUE
	THEN
		SET TILE (1, 8) = 21
		SET TILE (13, 8) = 17
	END
END

ENTERING SCREEN 13
	IF TRUE
	THEN
		SET TILE (8, 6) = 34
		SET TILE (9, 6) = 35
		SET TILE (8, 7) = 32
		SET TILE (9, 7) = 33
	END
END

PRESS FIRE AT SCREEN 13
	IF PLAYER NEAR 9, 7
	THEN
		EXTERN 0
		MUSIC 6
		WARP TO 20, 3, 7
	END
END

ENTERING SCREEN 14
	IF TRUE
	THEN
		SET TILE (10, 7) = 24
		SET TILE (8, 7) = 36
		SET TILE (4, 5) = 37
		SET TILE (7, 5) = 37
		SET TILE (10, 5) = 37
		SET TILE (2, 2) = 34
		SET TILE (12, 2) = 35
		SET FIRE ZONE 0, 0, 32, 192
	END
END

PRESS FIRE AT SCREEN 14
	IF PLAYER NEAR 10, 7
	IF FLAG 2 = 1
	THEN
		TEXT BOX "MEGHAN: AHORA LA MINA ESTA ABIERTA! VE A POR LA BOMBA!"
		REENTER
	END

	IF PLAYER NEAR 10, 7
	IF FLAG 2 = 0
	THEN
		TEXT BOX "MEGHAN: ME TEMO QUE NADIE PUEDE ENTRAR EN EL PUEBLO. HAN CONSTRUIDO ESA BARRERA PORQUE NO PARAN DE COLARSE MONOS SALIDOS."
		TEXT BOX "MEGHAN: ME PARECE QUE LA UNICA FORMA DE ENTRAR VA A SER VOLAR LA BARRERA. CREO QUE HAY EXPLOSIVOS EN LA MINA. AHORA TE LA ABRO."
		SET FLAG 2 = 1
		REENTER
	END

	IF PLAYER NEAR 10, 7
	IF FLAG 2 = 3
	THEN
		TEXT BOX "MEGHAN: JO, AHORA TENGO FRIO."
		REENTER
	END

	IF PLAYER NEAR 10, 7
	IF FLAG 2 = 2
	IF FLAG 5 = 0
	THEN
		TEXT BOX "MEGHAN: NO TENGO MECHAS. QUIZA EL GENIO DE LA TORMENTA TE PRESTE UN RAYO. ES UN GUARRO PERO ES GUAY."
		REENTER
	END

	IF PLAYER NEAR 10, 7
	IF FLAG 2 = 2
	IF FLAG 5 = 1
	THEN
		SET FLAG 2 = 3
		TEXT BOX "MEGHAN: NO TENGO MECHAS. QUIZA EL GENIO DE LA TORMENTA TE PRESTE UN RAYO. ES UN GUARRO PERO ES GUAY."
		TEXT BOX "MEGHAN: QUE NO TE HACE NI CASO? JO, ESPERATE, TOMA MIS BRAGAS. CON ESTO SEGURO QUE TE AYUDA. ME DEBES UNA!"
		SET FLAG 3 = 1
		EXTERN 4, 26
		REENTER
	END

	IF PLAYER NEAR 1, 7
	THEN
		EXTERN 0
		MUSIC 0
		WARP TO 7, 3, 7
	END
END

ENTERING SCREEN 15
	IF TRUE
	THEN
		SET TILE (0, 8) = 21
		SET TILE (3, 9) = 21
		SET TILE (12, 9) = 21
		SET TILE (6, 9) = 17
	END
END

ENTERING SCREEN 16
	IF TRUE
	THEN
		SET TILE (8, 9) = 21
		SET TILE (13, 8) = 17
		SET TILE (11, 9) = 17
		SET TILE (2, 9) = 17
	END

	IF FLAG 4 = 0
	THEN
		SET TILE (12, 8) = 25
		SET FIRE ZONE 177,113,208,144
	END
END

PRESS FIRE AT SCREEN 16
	IF FLAG 4 = 0
	IF PLAYER NEAR 12, 8
	THEN
		TEXT BOX "VAYA POR DIOS... LA BOMBA NO TIENE NI SIQUIERA UNA TRISTE MECHA. TENDRE QUE BUSCARME LA VIDA PARA HACERLA REVENTAR."
		SET FLAG 4 = 1
		SET FLAG 2 = 2
		EXTERN 5, 25
		REENTER
	END
END

ENTERING SCREEN 17
	IF TRUE
	THEN
		SET TILE (1, 7) = 42
		SET TILE (1, 8) = 21
		SET TILE (2, 9) = 21
		SET TILE (13, 8) = 17
		SET TILE (12, 9) = 17
	END
END

PRESS FIRE AT SCREEN 17
	IF PLAYER NEAR 1, 7
	THEN
		TEXT BOX "CARTEL: EL ACERTIJO DICE ;CANTA EL PEZ CON LA ESTRELLA DE MAR, LEVANTA LAS LOSAS Y LA VARITA DESCUBRIRAS;"
		REENTER
		# (En el original había aquí un SET TILE (1, 7) = 42 que nunca se
		# ejecutaba: REENTER acaba la cláusula.)
	END
END

ENTERING SCREEN 18
	IF TRUE
	THEN
		SET TILE (1, 3) = 39
		SET TILE (4, 3) = 40
		SET TILE (10, 3) = 38
		SET FLAG 11 = 0
	END
END

PRESS FIRE AT SCREEN 18
	# Había un bug: podrías reiniciar
	# con la varita ya cogida / aparecida
	IF PLAYER NEAR 10, 2
	IF FLAG 8 = 2
	THEN
		SOUND 22
	END

	IF PLAYER NEAR 10, 2
	IF FLAG 8 = 3
	THEN
		SOUND 22
	END

	IF PLAYER NEAR 10, 2
	IF FLAG 9 = 4
	THEN
		SOUND 22
	END

	# Nota musical: (re)iniciar
	IF PLAYER NEAR 10, 2
	IF FLAG 8 < 2
	IF FLAG 9 < 4
	THEN
		SET FLAG 9 = 1
		SOUND 16
	END

	# Mar (3)
	IF PLAYER NEAR 4, 2
	IF FLAG 9 <> 3
	THEN
		SET FLAG 9 = 0
		SOUND 22
	END

	IF PLAYER NEAR 4, 2
	IF FLAG 9 = 3
	THEN
		SET FLAG 9 = 4
		SET FLAG 11 = 1
		SOUND 16
		SET TILE (8, 5) = 43
		SET FIRE ZONE 113, 65, 143, 95
	END

	# Estrella (2)
	IF PLAYER NEAR 7, 2
	IF FLAG 9 <> 2
	THEN
		SET FLAG 9 = 0
		SOUND 22
	END

	IF PLAYER NEAR 7, 2
	IF FLAG 9 = 2
	THEN
		SET FLAG 9 = 3
		SOUND 16
	END

	# Pez (1)
	IF PLAYER NEAR 1, 2
	IF FLAG 9 <> 1
	THEN
		SET FLAG 9 = 0
		SOUND 22
	END

	IF PLAYER NEAR 1, 2
	IF FLAG 9 = 1
	THEN
		SET FLAG 9 = 2
		SOUND 16
	END

	# Varita (4)
	IF PLAYER NEAR 8, 5
	IF FLAG 11 = 1
	IF FLAG 8 < 2
	THEN
		SET FLAG 8 = 2
		TEXT BOX "TENGO LA VARITA MAGICA!"
		EXTERN 5, 43
		REENTER
	END
END

ENTERING SCREEN 19
	IF TRUE
	THEN
		SET TILE (4, 6) = 37
		SET TILE (7, 6) = 37
		SET TILE (10, 6) = 37
		SET TILE (3, 7) = 41
		SET TILE (5, 7) = 36
		SET TILE (1, 1) = 34
		SET TILE (7, 1) = 35
		SET TILE (13, 4) = 35
		SET FIRE ZONE 207, 0, 239, 159
	END
END

PRESS FIRE AT SCREEN 19
	IF PLAYER NEAR 13, 7
	THEN
		EXTERN 0
		MUSIC 0
		WARP TO 11, 7, 7
	END

	IF PLAYER NEAR 3, 7
	IF FLAG 8 = 1
	THEN
		TEXT BOX "MAGUFO: A VER SI TIENES SUERTE EN LA CUEVA"
		REENTER
	END

	IF PLAYER NEAR 3, 7
	IF FLAG 8 = 0
	THEN
		TEXT BOX "MAGUFO: ANTES HABIA PIEDROS PARA CRUZAR EL POZO DE LAVA QUE LLEVA A LA CASA DE TU CHICA, PERO LAS ROBO UN MONO."
		TEXT BOX "MAGUFO: CREO QUE PUEDO LEVANTAR OTROS CON MAGIA, PERO NECESITO LA VARITA QUE ESTA OCULTA EN MI CUEVA."
		TEXT BOX "MAGUFO: TE HE ABIERTO LA PUERTA DE LA CUEVA. VE A VER SI TIENES SUERTE... YO NO HE PODIDO RESOLVER EL ACERTIJO NUNCA!"
		SET FLAG 8 = 1
		REENTER
	END

	IF PLAYER NEAR 3, 7
	IF FLAG 8 = 3
	THEN
		TEXT BOX "MAGUFO: AHORA DEBERIAS PODER PASAR."
		REENTER
	END

	IF PLAYER NEAR 3, 7
	IF FLAG 8 = 2
	THEN
		TEXT BOX "MAGUFO: LA LECHE, QUE LISTO ERES! YO NUNCA PUDE RESOLVER EL ACERTIJO. AHORA, MAGIA: PIEDRO APARECE, CHIM PUM PAF!"
		SET FLAG 8 = 3
		EXTERN 5, 47
		REENTER
	END
END

ENTERING SCREEN 20
	IF TRUE
	THEN
		SET TILE (4, 6) = 37
		SET TILE (7, 6) = 37
		SET TILE (6, 3) = 44
		SET TILE (2, 4) = 34
		SET TILE (4, 1) = 34
		SET TILE (8, 0) = 34
		SET TILE (11, 0) = 35
		SET FIRE ZONE 0, 0, 32, 192
	END
END

PRESS FIRE AT SCREEN 20
	IF PLAYER NEAR 1, 7
	THEN
		EXTERN 0
		MUSIC 0
		WARP TO 13, 9, 7
	END

	IF PLAYER NEAR 6, 3
	THEN
		TEXT BOX "ESTA ES ANYA, LA HERMANA DE MI CHICA."
		TEXT BOX "ANYA: AY, NINJAJAR, TIENES QUE HACER ALGO! ANOCHE VINO UN MONO SALIDO Y SE LLEVO A TU CHICA. NO PUDE HACER NADA"
		TEXT BOX "ANYA: CREO QUE SE FUERON HACIA EL SUR. SEGURO QUE LA BRUJA SAROLLAN TE LO PUEDE MIRAR EN SU BOLA DE CRISTAL."
		TEXT BOX "ANYA: TEN CUIDADO, NINJAJAR, EL CAMINO ESTA LLENO DE BICHARRACOS Y ES MUY PELIGROSO. PERO SALVA A MI HERMANA!"
		EXTERN 0
		WIN GAME
	END
END
