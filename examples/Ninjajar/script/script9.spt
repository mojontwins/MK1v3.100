# Ninjajar - Nivel 10: el castillo de la carne de membrillo (mapa 9)
# Convertido del script original de 2014 (msc3) a msc4.

ROOMS = 16
TEXT WIDTH = 24


##############################################################################
# Level 10
##############################################################################

# Flag 2: All purpose trap
# Flag 3: ""
# Flag 4: ""
# Flag 5: ""
# Flag 6: 0 - puerta switches cerrada
#         1 - puerta switches abierta
#
# Flag 7: 0 - no tengo la llave inglesa
#         1 - tengo la llave inglesa
#         2 - puerta abierta
# Flag 8: 0 - no tengo el grifo
#         1 - tengo el grifo
#         2 - grifo usado (moco drenado)

ENTERING GAME
	IF TRUE
	THEN
		SET FLAG 3 = 0
		SET FLAG 4 = 0
		SET FLAG 5 = 0
		SET FLAG 6 = 0
		SET FLAG 7 = 0
		SET FLAG 8 = 0
		SET FLAG 9 = 0

	END
END

# Grifo
ENTERING SCREEN 0
	IF FLAG 8 = 0
	THEN
		SET TILE (12, 2) = 42
		SET FIRE ZONE 177, 17, 207, 47
	END
END

PRESS FIRE AT SCREEN 0
	IF FLAG 8 = 0
	IF PLAYER NEAR 12, 2
	THEN
		SET FLAG 8 = 1
		PRINT TILE (24, 22) = 42
		TEXT BOX "ES UN GRIFO VIEJO. ME LO GUARDO."
		REENTER
	END
END

# Cerrojo de luces
ENTERING SCREEN 1
	IF TRUE
	THEN
		SET TILE (4, 3) = 18
		SET TILE (6, 3) = 18
		SET TILE (8, 3) = 18
		SET TILE (10, 3) = 18
		SET FLAG 2 = 0
		SET FLAG 3 = 0
		SET FLAG 4 = 0
		SET FLAG 5 = 0
		SET TILE (3, 8) = 24
		SET TILE (12, 8) = 24
	END

	IF FLAG 6 = 0
	THEN
		SET TILE (4, 4) = 32
		SET TILE (6, 4) = 32
		SET TILE (8, 4) = 32
		SET TILE (10, 4) = 32
		SET TILE (7, 7) = 20
		SET TILE (7, 8) = 21
	END

	IF FLAG 6 = 1
	THEN
		SET TILE (4, 4) = 33
		SET TILE (6, 4) = 33
		SET TILE (8, 4) = 33
		SET TILE (10, 4) = 33
	END
END

PRESS FIRE AT SCREEN 1
	IF PLAYER NEAR 3, 8
	THEN
		TEXT BOX "MANTENIMIENTO: ATENCION! EL MECANISMO DE CIERRE ESTA CHUNGO, HAY ALGUNOS CABLES CRUZADOS."
		REENTER
	END

	IF PLAYER NEAR 12, 8
	THEN
		TEXT BOX "CARTEL: A LA DERECHA: LOS APOSENTOS DEL MONO"
		REENTER
	END

	# Switch A: 1, 2
	IF PLAYER NEAR 4, 2
	THEN
		SOUND 16
		FLIPFLOP $2
		FLIPFLOP $3
	END

	# Switch B: 1, 3
	IF PLAYER NEAR 6, 2
	THEN
		SOUND 16
		FLIPFLOP $2
		FLIPFLOP $4
	END

	# Switch C: 2
	IF PLAYER NEAR 8, 2
	THEN
		SOUND 16
		FLIPFLOP $3
	END

	# Switch D: 2, 4
	IF PLAYER NEAR 10, 2
	THEN
		SOUND 16
		FLIPFLOP $3
		FLIPFLOP $5
	END

	IF FLAG 2 = 0
	THEN
		SET TILE (4, 4) = 32
	END

	IF FLAG 2 = 1
	THEN
		SET TILE (4, 4) = 33
	END

	IF FLAG 3 = 0
	THEN
		SET TILE (6, 4) = 32
	END

	IF FLAG 3 = 1
	THEN
		SET TILE (6, 4) = 33
	END

	IF FLAG 4 = 0
	THEN
		SET TILE (8, 4) = 32
	END

	IF FLAG 4 = 1
	THEN
		SET TILE (8, 4) = 33
	END

	IF FLAG 5 = 0
	THEN
		SET TILE (10, 4) = 32
	END

	IF FLAG 5 = 1
	THEN
		SET TILE (10, 4) = 33
	END

	IF FLAG 2 = 1
	IF FLAG 3 = 1
	IF FLAG 4 = 1
	IF FLAG 5 = 1
	IF FLAG 6 = 0
	THEN
		# Open door
		SET FLAG 6 = 1
		SET TILE (7, 7) = 0
		SET TILE (7, 8) = 20
		SHOW
		SOUND 22
		PAUSE 30
		SET TILE (7, 8) = 0
		SHOW
		SOUND 22
	END
END

# Habitación inundada
ENTERING SCREEN 2
	IF FLAG 8 <> 2
	THEN
		SET FIRE ZONE 16, 0, 239, 159
	END

	IF FLAG 8 = 2
	THEN
		SET TILE (11, 8) = 0
		SET TILE (12, 8) = 0
		SET TILE (13, 8) = 0
		SET TILE (14, 8) = 0
	END
END

PRESS FIRE AT SCREEN 2
	IF FLAG 8 <> 2
	IF PLAYER IN_X 16, 239
	IF FLAG 9 = 0
	THEN
		TEXT BOX "VAYA, NO PODRE PASAR SI NO ENCUENTRO LA FORMA DE DRENAR ESTA HABITACION..."
		SET FLAG 9 = 1
		REENTER
	END
END

# Habitación del mono
ENTERING SCREEN 3
	IF TRUE
	THEN
		SET TILE (11, 7) = 43
		SET TILE (12, 7) = 44
		SET TILE (11, 8) = 45
		SET TILE (12, 8) = 46
		SET FIRE ZONE 120, 0, 239, 159
	END
END

PRESS FIRE AT SCREEN 3
	IF PLAYER IN_X 120, 239
	THEN
		TEXT BOX "MONO: POR FAVOR! POR FAVOR! NO ME PEGUES!"
		TEXT BOX "MONO: TE CONFUNDES DE CASTILLO Y DE MONO."
		TEXT BOX "MONO: YO NO TENGO A TU CHICA... DE HECHO HACE MUCHO QUE NO SALGO"
		TEXT BOX "MONO: PERO CREO QUE SE QUIEN SE LA HA PODIDO LLEVAR: GONZALO, EL MONO MALO, QUE VIVE EN EL CASTILLO DEL PEINADO DE CEPILLO."
		TEXT BOX "MONO: ASI QUE NO TENGO MAS REMEDIO QUE DECIRTE ;LO SIENTO, PERO TU PRINCESA ESTA EN OTRO CASTILLO;... SUERTE, TOMA UNA AYUDA!"
		INC LIFE, 3
		SOUND 20
		EXTERN 0
		WIN GAME
	END
END

# Activar la plataforma móvil
ENTERING SCREEN 4
	IF TRUE
	THEN
		SET TILE (11, 4) = 25
		ENEMY 0 OFF
		SET FLAG 2 = 0
	END
END

PRESS FIRE AT SCREEN 4
	IF PLAYER NEAR 11, 3
	IF FLAG 2 = 0
	THEN
		SOUND 16
		ENEMY 0 ON
		SET FLAG 2 = 1
	END
END

# Habitación de la puerta y la llave inglesa
ENTERING SCREEN 7
	IF FLAG 7 = 0
	THEN
		SET TILE (1, 2) = 34
		SET FIRE ZONE 8, 17, 31, 47
	END

	IF FLAG 7 <> 2
	THEN
		SET TILE (0, 7) = 20
		SET TILE (0, 8) = 21
	END

	IF TRUE
	THEN
		SET TILE (2, 8) = 24
	END
END

PRESS FIRE AT SCREEN 7
	IF FLAG 7 = 0
	IF PLAYER NEAR 1, 2
	THEN
		TEXT BOX "UNA LLAVE INGLESA. ME LA GUARDO."
		SET FLAG 7 = 1
		PRINT TILE (24, 22) = 34
		REENTER
	END

	IF PLAYER NEAR 2, 8
	THEN
		TEXT BOX "MANTENIMIENTO: LA MAQUINARIA DE LAS PUERTAS AUTOMATICAS DEL SOTANO ESTA ROTO."
		REENTER
	END
END

# Puzzle de la entrada
ENTERING SCREEN 9
	IF TRUE
	THEN
		SET FLAG 2 = 0
		SET TILE (13, 7) = 20
		SET TILE (13, 8) = 21
		SET TILE (2, 9) = 27
		SET TILE (5, 9) = 28
		SET TILE (8, 9) = 29
		SET TILE (11, 9) = 30
	END
END

PRESS FIRE AT SCREEN 9
	# Primera piedra:
	IF PLAYER NEAR 8, 8
	THEN
		SOUND 16
		SET FLAG 2 = 1
	END

	# Segunda piedra:
	IF PLAYER NEAR 5, 8
	IF FLAG 2 <> 1
	THEN
		SOUND 22
		SET FLAG 2 = 0
	END

	IF PLAYER NEAR 5, 8
	IF FLAG 2 = 1
	THEN
		SOUND 16
		SET FLAG 2 = 2
	END

	# Tercera piedra
	IF PLAYER NEAR 11, 8
	IF FLAG 2 <> 2
	THEN
		SOUND 22
		SET FLAG 2 = 0
	END

	IF PLAYER NEAR 11, 8
	IF FLAG 2 = 2
	THEN
		SOUND 16
		SET FLAG 2 = 3
	END

	# Cuarta piedra
	IF PLAYER NEAR 2, 8
	IF FLAG 2 <> 3
	THEN
		SOUND 22
		SET FLAG 2 = 0
	END

	IF PLAYER NEAR 2, 8
	IF FLAG 2 = 3
	THEN
		SOUND 16
		SET FLAG 2 = 4
		SET TILE (13, 7) = 0
		SET TILE (13, 8) = 20
		SHOW
		SOUND 22
		PAUSE 30
		SET TILE (13, 8) = 0
		SHOW
		SOUND 22
	END
END

# Trampa con pinchos
ENTERING SCREEN 10
	IF TRUE
	THEN
		SET FIRE ZONE 104, 16, 199, 79
		SET FLAG 2 = 0
	END
END

PRESS FIRE AT SCREEN 10
	IF FLAG 2 = 4
	THEN
		SET FLAG 2 = 5
		SOUND 22
		SET TILE (7, 5) = 0
		SAFE 5, 5
	END

	IF FLAG 2 = 3
	THEN
		SET FLAG 2 = 4
		SOUND 22
		SET TILE (8, 5) = 0
		SAFE 5, 5
	END

	IF FLAG 2 = 2
	THEN
		SET FLAG 2 = 3
		SOUND 22
		SET TILE (9, 5) = 0
		SAFE 5, 5
	END

	IF FLAG 2 = 1
	THEN
		SET FLAG 2 = 2
		SOUND 22
		SET TILE (10, 5) = 0
		SAFE 5, 5
	END

	IF FLAG 2 = 0
	IF PLAYER IN_X 112, 191
	THEN
		SET FLAG 2 = 1
		SOUND 22
		SET TILE (11, 5) = 0
		SAFE 5, 5
	END
END

# Cuarto de calderas/sotano
ENTERING SCREEN 12
	IF TRUE
	THEN
		SET TILE (1, 1) = 35
		SET TILE (1, 2) = 36
		SET TILE (2, 2) = 37
		SET TILE (4, 2) = 24
		SET TILE (2, 8) = 38
		SET TILE (3, 8) = 39
		SET TILE (4, 8) = 40
		SET TILE (6, 8) = 24
	END

	IF FLAG 8 = 2
	THEN
		SET TILE (4, 8) = 41
	END
END

PRESS FIRE AT SCREEN 12
	# Bomba de agua
	IF PLAYER NEAR 4, 8
	IF FLAG 8 = 0
	THEN
		TEXT BOX "UNA BOMBA DE EXTRACCION. NO LA PUEDO ENCENDER, FALTA EL GRIFO"
		REENTER
	END

	IF PLAYER NEAR 4, 8
	IF FLAG 8 = 2
	THEN
		TEXT BOX "UNA BOMBA DE EXTRACCION. SE OYE RUIDO DE AGUA."
		REENTER
	END

	IF PLAYER NEAR 4, 8
	IF FLAG 8 = 1
	THEN
		TEXT BOX "PONGO EL GRIFO EN LA BOMBA DE EXTRACCION Y LA ENCIENDO. SE OYE RUIDO DE AGUA."
		PRINT TILE (24, 22) = 47
		SET FLAG 8 = 2
		REENTER
	END

	# Generador eléctrico
	IF PLAYER NEAR 2, 2
	IF FLAG 7 <> 1
	THEN
		TEXT BOX "PARECE UN MOTOR ELEVADOR. ESTA BASTANTE VIEJO Y DEMACRADO."
		REENTER
	END

	IF PLAYER NEAR 2, 2
	IF FLAG 7 = 1
	THEN
		SOUND 16
		SET FLAG 7 = 2
		TEXT BOX "HE GIRADO UNA TUERCA CON LA LLAVE INGLESA Y HA EMPEZADO A FUNCIONAR. SE OYE UN MURMULLO HIDRAULICO."
		PRINT TILE (24, 22) = 47
		REENTER
	END

	IF PLAYER NEAR 4, 2
	THEN
		TEXT BOX "MANTENIMIENTO: HE PERDIDO LA LLAVE Y NO HAY QUIEN SAQUE LA TUERCA OXIDADA CON LAS MANOS."
		REENTER
	END

	IF PLAYER NEAR 6, 8
	THEN
		TEXT BOX "MANTENIMIENTO: HE COGIDO EL GRIFO DE LA BOMBA. LUEGO LO DEVUELVO, JEFE."
		REENTER
	END
END

# Trampa
ENTERING SCREEN 14
	IF TRUE
	THEN
		SET FLAG 2 = 0
		SET FLAG 3 = 0
		SET FLAG 4 = 0
		SET TILE (4, 5) = 26
		SET TILE (7, 5) = 26
		SET TILE (10, 5) = 26
		SET FIRE ZONE 49, 0, 175, 79
	END
END

PRESS FIRE AT SCREEN 14
	IF FLAG 2 = 0
	IF PLAYER IN_X 49, 79
	THEN
		SET FLAG 2 = 1
		SET TILE (4, 4) = 14
		SOUND 22
	END

	IF FLAG 3 = 0
	IF PLAYER IN_X 97, 127
	THEN
		SET FLAG 3 = 1
		SET TILE (7, 4) = 14
		SOUND 22
	END

	IF FLAG 4 = 0
	IF PLAYER IN_X 145, 175
	THEN
		SET FLAG 4 = 1
		SET TILE (10, 4) = 14
		SOUND 22
	END
END
