# Ninjajar - Nivel 16: el castillo de Gonzalo (mapa Z)
# Convertido del script original de 2014 (msc3) a msc4.

ROOMS = 20
TEXT WIDTH = 24


##############################################################################
# LEVEL Z - CASTILLO FINAL
##############################################################################

# ALLP = reaprovechable (ALL PURPOSE)
# flag 2: control de touchplates (15) (ALLP)
# flag 3: puerta abierta
# flag 4, 5: control de trampa (14) (ALLP)
# flag 6: piedra
# flag 7: papel
# flag 8: tijeras (0 = no, 1 = colocada)
# flag 9: objeto, 0 = no, 34 = piedra, 35 = papel, 36 = tijeras
# flag 10: contenedor objeto 1 (pantalla 12, (1, 9))
# flag 11: contenedor objeto 2
# flag 12: contenedor objeto 3
# flag 13: caja para la llave de cuerda (0 no 1 si 2 puesta)
# flags 14, 15, 16, 17, 18: puzzle luces
# flag 19: Puzzle luces OK
# flag 20: caja para la llave de cuerda 2 (0 no 1 si 2 puesta)
# flag 21: M.A.
# flag 22: Music
# flag 23: Secuencia de la puerta jaime dice

ENTERING GAME
	IF TRUE
	THEN
		SET FLAG 2 = 0
		SET FLAG 3 = 0
		SET FLAG 4 = 0
		SET FLAG 5 = 0
		SET FLAG 6 = 0
		SET FLAG 7 = 0
		SET FLAG 8 = 0
		SET FLAG 9 = 0
		SET FLAG 10 = 34 # piedra
		SET FLAG 11 = 35 # papel
		SET FLAG 12 = 36 # tijeras
		SET FLAG 13 = 0
		SET FLAG 19 = 0
		SET FLAG 20 = 0
		SET FLAG 21 = 0
		SET FLAG 22 = 0
		SET FLAG 23 = 0

		# final bueno!
		SET FLAG 28 = 1

		#WARP_TO 3, 12, 7
	END
END

# Tienda (dentro)
ENTERING SCREEN 0
	IF TRUE
	THEN
		SET TILE (7, 5) = 16
		SET TILE (10, 6) = 45
		SET TILE (10, 7) = 46
		SET FIRE ZONE 16, 49, 127, 96
	END
END

PRESS FIRE AT SCREEN 0
	IF PLAYER IN_X 16, 31
	IF FLAG 22 = 1
	THEN
		MUSIC 3
		SET FLAG 22 = 0
	END

	IF PLAYER IN_X 16, 31
	THEN
		EXTERN 0
		WARP TO 18, 10, 8
	END

	IF PLAYER NEAR 10, 7
	IF FLAG 22 = 0
	THEN
		MUSIC 15
		SET FLAG 22 = 1
	END

	IF PLAYER NEAR 10, 7
	IF FLAG 21 = 5
	THEN
		TEXT BOX "M.A.: FUERA DE MI VISTA, LOCO!"
		REENTER
	END

	IF PLAYER NEAR 10, 7
	IF FLAG 21 = 4
	THEN
		SET FLAG 21 = 5
		TEXT BOX "M.A.: PARECES DURO, PEQUE<AJO. M.A. TE REGALA UNA VIDA."
		INC LIFE, 1
		SOUND 20
		REENTER
	END

	IF PLAYER NEAR 10, 7
	IF FLAG 21 = 3
	THEN
		SET FLAG 21 = 4
		TEXT BOX "M.A.: TU DICES HOLA. YO DIGO MUERTE."
		REENTER
	END

	IF PLAYER NEAR 10, 7
	IF FLAG 21 = 2
	THEN
		SET FLAG 21 = 3
		TEXT BOX "M.A.: TRABAJO AQUI MIENTRAS ME REPARAN LA DMC. Y ESO ME CABREA."
		REENTER
	END

	IF PLAYER NEAR 10, 7
	IF FLAG 21 = 1
	THEN
		SET FLAG 21 = 2
		TEXT BOX "M.A.: TU PLAN PARA RESCATAR A TU NOVIA ES UNA LOCURA. POR ESO ES PERFECTO."
		REENTER
	END

	IF PLAYER NEAR 10, 7
	IF FLAG 21 = 0
	THEN
		SET FLAG 21 = 1
		TEXT BOX "M.A.: HOLA, PEQUE<AJO. MI NOMBRE ES M.A. BARACUS. PORTATE BIEN O TENDRAS QUE SALUDAR A MI AMIGO MR. NUDILLOS!"
		REENTER
	END

	IF PLAYER NEAR 7, 5
	IF FLAG 1 < 20
	THEN
		TEXT BOX "M.A.: CALLA, LOCO! NO TE QUEDA PASTA! FUERA DE AQUI O HABLARAS CON MI PU<O!"
		PY = 96
		REENTER
	END

	IF PLAYER NEAR 7, 5
	THEN
		TEXT BOX "M.A.: BUENA COMPRA."
		DEC $1, 20
		INC LIFE, 1
		SOUND 20
		PY = 96
		REENTER
	END
END

# Detectar y lanzar al final
ENTERING SCREEN 2
	IF TRUE
	THEN
		SET FIRE ZONE 0, 0, 239, 159
	END
END

PRESS FIRE AT SCREEN 2
	IF TRUE
	THEN
		WARP TO LEVEL 23, 0, 12, 8, 1
	END
END

# Puzzle jaime dice
# Como no hay vuelta atrás, puedo reaprovechar
# flags.
# Flag 23: Secuencia (0, 1, 2)
# Flag 4: Orden de pisar

ENTERING SCREEN 3
	IF TRUE
	THEN
		SET FLAG 4 = 0
		SET TILE (0, 7) = 20
		SET TILE (0, 8) = 21
		SET TILE (5, 4) = 12
		SET TILE (7, 4) = 12
		SET TILE (9, 4) = 12
		SET TILE (7, 9) = 18
		SET TILE (4, 8) = 23
		SET TILE (0, 4) = 32
		SET TILE (0, 5) = 32
		SET TILE (0, 6) = 32
	END

	IF FLAG 23 > 0
	THEN
		SET TILE (0, 4) = 33
	END

	IF FLAG 23 > 1
	THEN
		SET TILE (0, 5) = 33
	END

	IF FLAG 23 = 3
	THEN
		SET TILE (0, 6) = 33
		SET TILE (0, 7) = 0
		SET TILE (0, 8) = 0
	END
END

PRESS FIRE AT SCREEN 3
	# Explicación
	IF PLAYER NEAR 4, 8
	THEN
		TEXT BOX "GENIO: ESTA ES LA PRUEBA FINAL. TIENES QUE ESTAR MUY ATENTO, NINJAJAR."
		TEXT BOX "GENIO: CUANDO PULSES LA BALDOSA RAYO EMPEZARA UNA SECUENCIA. FIJATE BIEN."
		TEXT BOX "GENIO: LUEGO TENDRAS QUE SUBIR ARRIBA Y REPETIR LA MISMA SECUENCIA ..."
		TEXT BOX "GENIO: SI TE EQUIVOCAS, PERDERAS UNA VIDA, ASI QUE PRESTA MUCHA ATENCION."
		TEXT BOX "GENIO: PUEDES REPETIR PULSANDO LA BALDOSA RAYO SIEMPRE QUE QUIERAS, CLARO."
		TEXT BOX "GENIO: CUANDO COMPLETES TRES SECUENCIAS, SE ABRIRA LA PUERTA FINAL! ANIMO!"
		REENTER
	END

	# Iniciar
	IF PLAYER NEAR 7, 8
	IF FLAG 23 = 0
	THEN
		# 1
		SET TILE (5, 4) = 47
		SHOW
		SOUND 18
		PAUSE 15
		SET TILE (5, 4) = 12

		# 2
		SET TILE (7, 4) = 47
		SHOW
		SOUND 18
		PAUSE 15
		SET TILE (7, 4) = 12

		# 3
		SET TILE (9, 4) = 47
		SHOW
		SOUND 18
		PAUSE 15
		SET TILE (9, 4) = 12

		# 1
		SET TILE (5, 4) = 47
		SHOW
		SOUND 18
		PAUSE 15
		SET TILE (5, 4) = 12

		SET FLAG 4 = 0
	END

	IF PLAYER NEAR 7, 8
	IF FLAG 23 = 1
	THEN
		# 3
		SET TILE (9, 4) = 47
		SHOW
		SOUND 18
		PAUSE 15
		SET TILE (9, 4) = 12

		# 2
		SET TILE (7, 4) = 47
		SHOW
		SOUND 18
		PAUSE 15
		SET TILE (7, 4) = 12

		# 1
		SET TILE (5, 4) = 47
		SHOW
		SOUND 18
		PAUSE 15
		SET TILE (5, 4) = 12

		# 2
		SET TILE (7, 4) = 47
		SHOW
		SOUND 18
		PAUSE 15
		SET TILE (7, 4) = 12

		# 3
		SET TILE (9, 4) = 47
		SHOW
		SOUND 18
		PAUSE 15
		SET TILE (9, 4) = 12

		# 1
		SET TILE (5, 4) = 47
		SHOW
		SOUND 18
		PAUSE 15
		SET TILE (5, 4) = 12

		SET FLAG 4 = 0
	END

	IF PLAYER NEAR 7, 8
	IF FLAG 23 = 2
	THEN
		# 1, 3, 1, 2, 1, 3, 2, 1, 3

		# 1
		SET TILE (5, 4) = 47
		SHOW
		SOUND 18
		PAUSE 15
		SET TILE (5, 4) = 12

		# 3
		SET TILE (9, 4) = 47
		SHOW
		SOUND 18
		PAUSE 15
		SET TILE (9, 4) = 12

		# 1
		SET TILE (5, 4) = 47
		SHOW
		SOUND 18
		PAUSE 15
		SET TILE (5, 4) = 12

		# 2
		SET TILE (7, 4) = 47
		SHOW
		SOUND 18
		PAUSE 15
		SET TILE (7, 4) = 12

		# 1
		SET TILE (5, 4) = 47
		SHOW
		SOUND 18
		PAUSE 15
		SET TILE (5, 4) = 12

		# 3
		SET TILE (9, 4) = 47
		SHOW
		SOUND 18
		PAUSE 15
		SET TILE (9, 4) = 12

		# 2
		SET TILE (7, 4) = 47
		SHOW
		SOUND 18
		PAUSE 15
		SET TILE (7, 4) = 12

		# 1
		SET TILE (5, 4) = 47
		SHOW
		SOUND 18
		PAUSE 15
		SET TILE (5, 4) = 12

		# 3
		SET TILE (9, 4) = 47
		SHOW
		SOUND 18
		PAUSE 15
		SET TILE (9, 4) = 12

		SET FLAG 4 = 0
	END

	# Pulsaciones
	# UFFFF!!!

	# Secuencia 3
	# 1, 3, 1, 2, 1, 3, 2, 1, 3

	# Baldosa 1
	IF FLAG 23 = 2
	IF PLAYER NEAR 5, 3
	IF FLAG 4 <> 0
	IF FLAG 4 <> 2
	IF FLAG 4 <> 4
	IF FLAG 4 <> 7
	THEN
		SET FLAG 4 = 0
		TEXT BOX "GENIO: MUY MAL! UNA VIDA MENOS. Y EMPIEZAS DE NUEVO."
		SOUND 22
		DEC LIFE, 1
		REENTER
	END

	IF FLAG 23 = 2
	IF PLAYER NEAR 5, 3
	IF FLAG 4 = 0
	THEN
		SET FLAG 4 = 1
		SOUND 16
	END

	IF FLAG 23 = 2
	IF PLAYER NEAR 5, 3
	IF FLAG 4 = 2
	THEN
		SET FLAG 4 = 3
		SOUND 16
	END

	IF FLAG 23 = 2
	IF PLAYER NEAR 5, 3
	IF FLAG 4 = 4
	THEN
		SET FLAG 4 = 5
		SOUND 16
	END

	IF FLAG 23 = 2
	IF PLAYER NEAR 5, 3
	IF FLAG 4 = 7
	THEN
		SET FLAG 4 = 8
		SOUND 16
	END

	# Baldosa 2
	IF FLAG 23 = 2
	IF PLAYER NEAR 7, 3
	IF FLAG 4 <> 3
	IF FLAG 4 <> 6
	THEN
		SET FLAG 4 = 0
		TEXT BOX "GENIO: MUY MAL! UNA VIDA MENOS. Y EMPIEZAS DE NUEVO."
		SOUND 22
		DEC LIFE, 1
		REENTER
	END

	IF FLAG 23 = 2
	IF PLAYER NEAR 7, 3
	IF FLAG 4 = 3
	THEN
		SET FLAG 4 = 4
		SOUND 16
	END

	IF FLAG 23 = 2
	IF PLAYER NEAR 7, 3
	IF FLAG 4 = 6
	THEN
		SET FLAG 4 = 7
		SOUND 16
	END

	# Baldosa 3
	IF FLAG 23 = 2
	IF PLAYER NEAR 9, 3
	IF FLAG 4 <> 1
	IF FLAG 4 <> 5
	IF FLAG 4 <> 8
	THEN
		SET FLAG 4 = 0
		TEXT BOX "GENIO: MUY MAL! UNA VIDA MENOS. Y EMPIEZAS DE NUEVO."
		SOUND 22
		DEC LIFE, 1
		REENTER
	END

	IF FLAG 23 = 2
	IF PLAYER NEAR 9, 3
	IF FLAG 4 = 1
	THEN
		SET FLAG 4 = 2
		SOUND 16
	END

	IF FLAG 23 = 2
	IF PLAYER NEAR 9, 3
	IF FLAG 4 = 5
	THEN
		SET FLAG 4 = 6
		SOUND 16
	END

	#fin!!!
	IF FLAG 23 = 2
	IF PLAYER NEAR 9, 3
	IF FLAG 4 = 8
	THEN
		SET FLAG 4 = 0
		# FIN!
		SET FLAG 23 = 3

		SET TILE (0, 6) = 33
		SOUND 16
		SHOW
		PAUSE 20

		SET TILE (0, 7) = 0
		SET TILE (0, 8) = 20
		SOUND 22
		SHOW
		PAUSE 20

		SET TILE (0, 8) = 0
		SOUND 22
		SHOW
		PAUSE 20

		TEXT BOX "GENIO: BIEN HECHO, NINJAJAR! AHORA A HACERLE UNA PACHOCHA AL MONO!"
		REENTER
	END

	# Secuencia 2
	# 3, 2, 1, 2, 3, 1

	# Baldosa 1
	IF FLAG 23 = 1
	IF PLAYER NEAR 5, 3
	IF FLAG 4 <> 2
	IF FLAG 4 <> 5
	THEN
		SET FLAG 4 = 0
		TEXT BOX "GENIO: MUY MAL! UNA VIDA MENOS. Y EMPIEZAS DE NUEVO."
		SOUND 22
		DEC LIFE, 1
		REENTER
	END

	IF FLAG 23 = 1
	IF PLAYER NEAR 5, 3
	IF FLAG 4 = 2
	THEN
		SET FLAG 4 = 3
		SOUND 16
	END

	IF FLAG 23 = 1
	IF PLAYER NEAR 5, 3
	IF FLAG 4 = 5
	THEN
		SET FLAG 4 = 0
		# NEXT
		SET FLAG 23 = 2
		SET TILE (0, 5) = 33
		SOUND 16
		TEXT BOX "GENIO: PERFECTO, YA SOLO TE QUEDA LA ULTIMA SECUENCIA"
		REENTER
	END

	# Baldosa 2
	IF FLAG 23 = 1
	IF PLAYER NEAR 7, 3
	IF FLAG 4 <> 1
	IF FLAG 4 <> 3
	THEN
		SET FLAG 4 = 0
		TEXT BOX "GENIO: MUY MAL! UNA VIDA MENOS. Y EMPIEZAS DE NUEVO."
		SOUND 22
		DEC LIFE, 1
		REENTER
	END

	IF FLAG 23 = 1
	IF PLAYER NEAR 7, 3
	IF FLAG 4 = 1
	THEN
		SET FLAG 4 = 2
		SOUND 16
	END

	IF FLAG 23 = 1
	IF PLAYER NEAR 7, 3
	IF FLAG 4 = 3
	THEN
		SET FLAG 4 = 4
		SOUND 16
	END

	# Baldosa 3
	IF FLAG 23 = 1
	IF PLAYER NEAR 9, 3
	IF FLAG 4 <> 0
	IF FLAG 4 <> 4
	THEN
		SET FLAG 4 = 0
		TEXT BOX "GENIO: MUY MAL! UNA VIDA MENOS. Y EMPIEZAS DE NUEVO."
		SOUND 22
		DEC LIFE, 1
		REENTER
	END

	IF FLAG 23 = 1
	IF PLAYER NEAR 9, 3
	IF FLAG 4 = 0
	THEN
		SET FLAG 4 = 1
		SOUND 16
	END

	IF FLAG 23 = 1
	IF PLAYER NEAR 9, 3
	IF FLAG 4 = 4
	THEN
		SET FLAG 4 = 5
		SOUND 16
	END

	# Secuencia 1
	# 1,2,3,1

	# Baldosa 1
	IF FLAG 23 = 0
	IF PLAYER NEAR 5, 3
	IF FLAG 4 <> 0
	IF FLAG 4 <> 3
	THEN
		SET FLAG 4 = 0
		TEXT BOX "GENIO: MUY MAL! UNA VIDA MENOS. Y EMPIEZAS DE NUEVO."
		SOUND 22
		DEC LIFE, 1
		REENTER
	END

	IF FLAG 23 = 0
	IF PLAYER NEAR 5, 3
	IF FLAG 4 = 0
	THEN
		SET FLAG 4 = 1
		SOUND 16
	END

	IF FLAG 23 = 0
	IF PLAYER NEAR 5, 3
	IF FLAG 4 = 3
	THEN
		SET FLAG 4 = 0
		# NEXT
		SET FLAG 23 = 1
		SET TILE (0, 4) = 33
		SOUND 16
		TEXT BOX "GENIO: BIEN, LA PRIMERA SECUENCIA ESTA COMPLETA. PULSA DE NUEVO PARA LA SIGUIENTE"
		REENTER
	END

	# Baldosa 2
	IF FLAG 23 = 0
	IF PLAYER NEAR 7, 3
	IF FLAG 4 <> 1
	THEN
		SET FLAG 4 = 0
		TEXT BOX "GENIO: MUY MAL! UNA VIDA MENOS. Y EMPIEZAS DE NUEVO."
		SOUND 22
		DEC LIFE, 1
		REENTER
	END

	IF FLAG 23 = 0
	IF PLAYER NEAR 7, 3
	IF FLAG 4 = 1
	THEN
		SET FLAG 4 = 2
		SOUND 16
	END

	# Baldosa 3
	IF FLAG 23 = 0
	IF PLAYER NEAR 9, 3
	IF FLAG 4 <> 2
	THEN
		SET FLAG 4 = 0
		TEXT BOX "GENIO: MUY MAL! UNA VIDA MENOS. Y EMPIEZAS DE NUEVO."
		SOUND 22
		DEC LIFE, 1
		REENTER
	END

	IF FLAG 23 = 0
	IF PLAYER NEAR 9, 3
	IF FLAG 4 = 2
	THEN
		SET FLAG 4 = 3
		SOUND 16
	END
END

# Llave de cuerda 2
ENTERING SCREEN 5
	IF FLAG 20 = 0
	THEN
		SET TILE (8, 3) = 37
		SET FIRE ZONE 113, 33, 143, 63
	END
END

PRESS FIRE AT SCREEN 5
	IF PLAYER NEAR 8, 3
	IF FLAG 20 = 0
	THEN
		SET TILE (8, 3) = 0
		PRINT TILE (24, 22) = 37
		SET FLAG 20 = 1
		SOUND 20
	END
END

# Puzzle luces
ENTERING SCREEN 6
	IF TRUE
	THEN
		SET FLAG 14 = 0
		SET FLAG 15 = 0
		SET FLAG 16 = 0
		SET FLAG 17 = 0
		SET FLAG 18 = 0
		SET TILE (12, 8) = 38
		SET TILE (3, 3) = 18
		SET TILE (5, 3) = 18
		SET TILE (7, 3) = 18
		SET TILE (9, 3) = 18
		SET TILE (11, 3) = 18
		SET TILE (5, 8) = 24
	END

	IF FLAG 19 = 0
	THEN
		SET TILE (1, 7) = 20
		SET TILE (1, 8) = 21
		SET TILE (3, 4) = 32
		SET TILE (5, 4) = 32
		SET TILE (7, 4) = 32
		SET TILE (9, 4) = 32
		SET TILE (11, 4) = 32
		ENEMY 1 ON
	END

	IF FLAG 19 = 1
	THEN
		SET TILE (3, 4) = 33
		SET TILE (5, 4) = 33
		SET TILE (7, 4) = 33
		SET TILE (9, 4) = 33
		SET TILE (11, 4) = 33
		ENEMY 1 OFF
	END

	IF FLAG 20 = 2
	THEN
		SET TILE (12, 7) = 37
	END

	IF FLAG 20 <> 2
	THEN
		ENEMY 0 OFF
	END
END

PRESS FIRE AT SCREEN 6
	# Switch 1: 15, 18
	IF PLAYER NEAR 3, 2
	THEN
		FLIPFLOP $15
		FLIPFLOP $18
		SOUND 16
	END

	# Switch 2: 14, 16
	IF PLAYER NEAR 5, 2
	THEN
		FLIPFLOP $14
		FLIPFLOP $16
		SOUND 16
	END

	# Switch 3: 14, 16, 18
	IF PLAYER NEAR 7, 2
	THEN
		FLIPFLOP $14
		FLIPFLOP $16
		FLIPFLOP $18
		SOUND 16
	END

	# Switch 4: 16, 18
	IF PLAYER NEAR 9, 2
	THEN
		FLIPFLOP $16
		FLIPFLOP $18
		SOUND 16
	END

	# Switch 5: 17, 14
	IF PLAYER NEAR 11, 2
	THEN
		FLIPFLOP $14
		FLIPFLOP $17
		SOUND 16
	END

	# Show lights
	IF FLAG 14 = 0
	THEN
		SET TILE (3, 4) = 32
	END

	IF FLAG 14 = 1
	THEN
		SET TILE (3, 4) = 33
	END

	IF FLAG 15 = 0
	THEN
		SET TILE (5, 4) = 32
	END

	IF FLAG 15 = 1
	THEN
		SET TILE (5, 4) = 33
	END

	IF FLAG 16 = 0
	THEN
		SET TILE (7, 4) = 32
	END

	IF FLAG 16 = 1
	THEN
		SET TILE (7, 4) = 33
	END

	IF FLAG 17 = 0
	THEN
		SET TILE (9, 4) = 32
	END

	IF FLAG 17 = 1
	THEN
		SET TILE (9, 4) = 33
	END

	IF FLAG 18 = 0
	THEN
		SET TILE (11, 4) = 32
	END

	IF FLAG 18 = 1
	THEN
		SET TILE (11, 4) = 33
	END

	# Abrir puerta
	IF FLAG 14 = 1
	IF FLAG 15 = 1
	IF FLAG 16 = 1
	IF FLAG 17 = 1
	IF FLAG 18 = 1
	IF FLAG 19 = 0
	THEN
		SET FLAG 19 = 1
		SOUND 22
		SET TILE (1, 7) = 0
		SET TILE (1, 8) = 20
		SHOW
		PAUSE 30
		SOUND 22
		SET TILE (1, 8) = 0
		SHOW
	END

	# llave
	IF PLAYER NEAR 12, 7
	IF FLAG 20 = 2
	THEN
		TEXT BOX "LA LLAVE ESTA FIJADA A LA CAJA Y NO SE MOVERA. SI QUIERO UNA TENDRE QUE BUSCAR OTRA."
		REENTER
	END

	IF PLAYER NEAR 12, 7
	IF FLAG 20 = 1
	THEN
		SET FLAG 20 = 2
		SET TILE (12, 7) = 37
		SOUND 16
		ENEMY 0 ON
	END

	IF PLAYER NEAR 12, 7
	IF FLAG 20 = 0
	THEN
		TEXT BOX "PARECE QUE FALTA UNA LLAVE DE DAR CUERDA."
		REENTER
	END

	# Cartel
	IF PLAYER NEAR 5, 8
	THEN
		TEXT BOX "CARTEL: HAY QUE ENCENDER LAS LUCES PARA ABRIR LA PUERTA. LOS INTERRUPTORES ESTAN UN POCO CASCADOS."
		TEXT BOX "JODO, HAY QUE VER LO QUE FALLAN ESTE TIPO DE CERRADURAS. NO SE POR QUE LAS PONEN EN TODOS LOS CASTILLOS."
		REENTER
	END
END

# activar plataforma
ENTERING SCREEN 7
	IF TRUE
	THEN
		SET FLAG 2 = 0
		ENEMY 0 OFF
		SET TILE (5, 6) = 18
	END
END

PRESS FIRE AT SCREEN 7
	IF PLAYER NEAR 5, 5
	IF FLAG 2 = 0
	THEN
		SOUND 16
		SET FLAG 2 = 1
		ENEMY 0 ON
	END
END

# Contenedor 2
ENTERING SCREEN 8
	IF TRUE
	THEN
		SET TILE (1, 3) = #11
	END
END

PRESS FIRE AT SCREEN 8
	IF PLAYER NEAR 1, 3
	IF FLAG 9 <> 0
	IF FLAG 11 <> 0
	THEN
		TEXT BOX "ESTO PESA MUCHO. TENGO QUE DEJAR AQUI LA ESCULTURA QUE LLEVO..."
		SOUND 20
		# Swap. Hay un comando para esto, pero así ahorro memoria convencional.
		PRINT TILE (24, 22) = #11
		SET FLAG 2 = #9
		SET FLAG 9 = #11
		SET FLAG 11 = #2
		REENTER
	END

	IF PLAYER NEAR 1, 3
	IF FLAG 9 = 0
	IF FLAG 11 <> 0
	THEN
		TEXT BOX "UNA ESCULTURA ENORME. ME LA LLEVO."
		SOUND 20
		SET FLAG 9 = #11
		PRINT TILE (24, 22) = #11
		SET FLAG 11 = 0
		REENTER
	END
END

# Contenedor 3 y caja con llave para plataforma móvil
ENTERING SCREEN 9
	IF TRUE
	THEN
		SET TILE (5, 8) = #12
		SET TILE (8, 7) = 38
	END

	IF FLAG 13 <> 2
	THEN
		ENEMY 0 OFF
	END

	IF FLAG 13 = 2
	THEN
		SET TILE (8, 6) = 37
	END
END

PRESS FIRE AT SCREEN 9
	IF PLAYER NEAR 5, 8
	IF FLAG 9 <> 0
	IF FLAG 12 <> 0
	THEN
		TEXT BOX "ESTO PESA MUCHO. TENGO QUE DEJAR AQUI LA ESCULTURA QUE LLEVO..."
		SOUND 20
		# Swap. Hay un comando para esto, pero así ahorro memoria convencional.
		PRINT TILE (24, 22) = #12
		SET FLAG 2 = #9
		SET FLAG 9 = #12
		SET FLAG 12 = #2
		REENTER
	END

	IF PLAYER NEAR 5, 8
	IF FLAG 9 = 0
	IF FLAG 12 <> 0
	THEN
		TEXT BOX "UNA ESCULTURA ENORME. ME LA LLEVO."
		SOUND 20
		SET FLAG 9 = #12
		PRINT TILE (24, 22) = #12
		SET FLAG 12 = 0
		REENTER
	END

	IF PLAYER NEAR 8, 6
	IF FLAG 13 = 0
	THEN
		TEXT BOX "PARECE QUE FALTA UNA LLAVE DE DAR CUERDA."
		REENTER
	END

	IF PLAYER NEAR 8, 6
	IF FLAG 13 = 2
	THEN
		TEXT BOX "LA LLAVE ESTA FIJADA A LA CAJA Y NO SE MOVERA. SI QUIERO UNA TENDRE QUE BUSCAR OTRA."
		REENTER
	END

	IF PLAYER NEAR 8, 6
	IF FLAG 13 = 1
	THEN
		PRINT TILE (24, 22) = 0
		SET TILE (8, 6) = 37
		SET FLAG 13 = 2
		ENEMY 0 ON
		SOUND 16
	END
END

# Contenedor 1
ENTERING SCREEN 12
	IF TRUE
	THEN
		SET TILE (1, 8) = #10
	END
END

PRESS FIRE AT SCREEN 12
	IF PLAYER NEAR 1, 8
	IF FLAG 9 <> 0
	IF FLAG 10 <> 0
	THEN
		TEXT BOX "ESTO PESA MUCHO. TENGO QUE DEJAR AQUI LA ESCULTURA QUE LLEVO..."
		SOUND 20
		# Swap. Hay un comando para esto, pero así ahorro memoria convencional.
		PRINT TILE (24, 22) = #10
		SET FLAG 2 = #9
		SET FLAG 9 = #10
		SET FLAG 10 = #2
		REENTER
	END

	IF PLAYER NEAR 1, 8
	IF FLAG 9 = 0
	IF FLAG 10 <> 0
	THEN
		TEXT BOX "UNA ESCULTURA ENORME. ME LA LLEVO."
		SOUND 20
		SET FLAG 9 = #10
		PRINT TILE (24, 22) = #10
		SET FLAG 10 = 0
		REENTER
	END
END

# Puerta piedra-papel-tijeras
ENTERING SCREEN 13
	IF TRUE
	THEN
		SET TILE (5, 9) = 27
		SET TILE (7, 9) = 29
		SET TILE (9, 9) = 30
	END

	# Puzzle resuelto
	IF FLAG 6 = 1
	IF FLAG 7 = 1
	IF FLAG 8 = 1
	THEN
		SET TILE (11, 9) = 0
	END

	# Piedra vencida
	IF FLAG 6 = 1
	THEN
		SET TILE (5, 8) = 35
	END

	# Papel vencido
	IF FLAG 7 = 1
	THEN
		SET TILE (7, 8) = 36
	END

	# Tijeras vencidas
	IF FLAG 8 = 1
	THEN
		SET TILE (9, 8) = 34
	END
END

PRESS FIRE AT SCREEN 13
	# Altar "Piedra" se vence con papel (flag 9 = 2)
	IF PLAYER NEAR 5, 8
	IF FLAG 9 <> 35
	THEN
		SOUND 22
	END

	IF PLAYER NEAR 5, 8
	IF FLAG 9 = 35
	THEN
		SET FLAG 9 = 0
		PRINT TILE (24, 22) = 0
		SET FLAG 6 = 1
		SOUND 16
		REENTER
	END

	# Altar "Papel" se vence con tijeras (flag 9 = 3)
	IF PLAYER NEAR 7, 8
	IF FLAG 9 <> 36
	THEN
		SOUND 22
	END

	IF PLAYER NEAR 7, 8
	IF FLAG 9 = 36
	THEN
		SET FLAG 9 = 0
		PRINT TILE (24, 22) = 0
		SET FLAG 7 = 1
		SOUND 16
		REENTER
	END

	# Altar "Tijeras" se vence con piedra (flag 9 = 1)
	IF PLAYER NEAR 9, 8
	IF FLAG 9 <> 34
	THEN
		SOUND 22
	END

	IF PLAYER NEAR 9, 8
	IF FLAG 9 = 34
	THEN
		SET FLAG 9 = 0
		PRINT TILE (24, 22) = 0
		SET FLAG 8 = 1
		SOUND 16
		REENTER
	END
END

# Trampa chunga
ENTERING SCREEN 14
	IF TRUE
	THEN
		SET FLAG 4 = 0
		SET FLAG 5 = 0
		SET FIRE ZONE 48, 16, 144, 79
	END
END

PRESS FIRE AT SCREEN 14
	IF PLAYER IN_X 48, 80
	IF FLAG 4 = 2
	THEN
		SET FLAG 4 = 3
		SOUND 22
		SET TILE (5, 5) = 0
	END

	IF PLAYER IN_X 48, 80
	IF FLAG 4 = 1
	THEN
		SET FLAG 4 = 2
		SOUND 22
		SET TILE (4, 5) = 0
	END

	IF PLAYER IN_X 48, 80
	IF FLAG 4 = 0
	THEN
		SET FLAG 4 = 1
		SOUND 22
		SET TILE (3, 5) = 0
	END

	IF PLAYER IN_X 112, 144
	IF FLAG 5 = 2
	THEN
		SET FLAG 5 = 3
		SOUND 22
		SET TILE (9, 5) = 0
	END

	IF PLAYER IN_X 112, 144
	IF FLAG 5 = 1
	THEN
		SET FLAG 5 = 2
		SOUND 22
		SET TILE (8, 5) = 0
	END

	IF PLAYER IN_X 112, 144
	IF FLAG 5 = 0
	THEN
		SET FLAG 5 = 1
		SOUND 22
		SET TILE (7, 5) = 0
	END
END

# Puzzle de entrada.
# Pisar en orden: HOJA, LUNA, AGUA, PIEDRA, ESTRELLA.
# Si se pisan otra vez -> secreto.

ENTERING SCREEN 15
	IF TRUE
	THEN
		# agua
		SET TILE (3, 9) = 25
		# estrella
		SET TILE (5, 9) = 12
		# luna
		SET TILE (7, 9) = 26
		# hoja
		SET TILE (9, 9) = 28
		# piedra
		SET TILE (11, 9) = 27
		SET FLAG 2 = 0
	END

	IF FLAG 3 = 0
	THEN
		SET TILE (1, 7) = 20
		SET TILE (1, 8) = 21
	END

	IF FLAG 3 = 2
	THEN
		SET TILE (7, 1) = 13
		SET TILE (8, 3) = 13
		SET TILE (7, 5) = 13
		SET TILE (8, 7) = 13
	END
END

PRESS FIRE AT SCREEN 15
	# Empezamos por la hoja
	IF PLAYER NEAR 9, 8
	THEN
		SET FLAG 2 = 1
		SOUND 16
	END

	# Luna
	IF PLAYER NEAR 7, 8
	IF FLAG 2 <> 1
	THEN
		SOUND 22
		SET FLAG 2 = 0
	END

	IF PLAYER NEAR 7, 8
	IF FLAG 2 = 1
	THEN
		SOUND 16
		SET FLAG 2 = 2
	END

	# DUMMY +2A. DON'T ASK. CROSS FINGERS
	IF PLAYER NEAR 0, 0
	IF FLAG 2 <> 8
	THEN
		SOUND 22
		SET FLAG 2 = 0
	END

	# Agua
	IF PLAYER NEAR 3, 8
	IF FLAG 2 <> 2
	THEN
		SOUND 22
		SET FLAG 2 = 0
	END

	IF PLAYER NEAR 3, 8
	IF FLAG 2 = 2
	THEN
		SOUND 16
		SET FLAG 2 = 3
	END

	# Piedra
	IF PLAYER NEAR 11, 8
	IF FLAG 2 <> 3
	THEN
		SOUND 22
		SET FLAG 2 = 0
	END

	IF PLAYER NEAR 11, 8
	IF FLAG 2 = 3
	THEN
		SOUND 16
		SET FLAG 2 = 4
	END

	# Estrella
	IF PLAYER NEAR 5, 8
	IF FLAG 2 <> 4
	THEN
		SOUND 22
		SET FLAG 2 = 0
	END

	IF PLAYER NEAR 5, 8
	IF FLAG 2 = 4
	IF FLAG 3 = 1
	THEN
		SOUND 16
		SET TILE (7, 1) = 13
		SET TILE (8, 3) = 13
		SET TILE (7, 5) = 13
		SET TILE (8, 7) = 13
		SET FLAG 3 = 2
	END

	IF PLAYER NEAR 5, 8
	IF FLAG 2 = 4
	IF FLAG 3 = 0
	THEN
		SET FLAG 3 = 1
		SET FLAG 2 = 0
		SOUND 16
		SET TILE (1, 7) = 0
		SET TILE (1, 8) = 20
		SHOW
		PAUSE 30
		SOUND 22
		SET TILE (1, 8) = 0
	END
END

# Llave de cuerda
ENTERING SCREEN 16
	IF FLAG 13 = 0
	THEN
		SET TILE (6, 3) = 37
		SET FIRE ZONE 81, 33, 111, 63
	END
END

PRESS FIRE AT SCREEN 16
	IF FLAG 13 = 0
	IF PLAYER NEAR 6, 3
	THEN
		SET FLAG 13 = 1
		TEXT BOX "UNA LLAVE DE DAR CUERDA. ME LA LLEVO!"
		PRINT TILE (24, 22) = 37
		SOUND 20
		REENTER
	END
END

# Tienda (fuera)
ENTERING SCREEN 18
	IF TRUE
	THEN
		SET TILE (9, 7) = 39
		SET TILE (10, 7) = 40
		SET TILE (11, 7) = 41
		SET TILE (9, 8) = 42
		SET TILE (10, 8) = 43
		SET TILE (11, 8) = 44
		SET TILE (8, 8) = 24
	END
END

PRESS FIRE AT SCREEN 18
	IF PLAYER NEAR 10, 8
	THEN
		EXTERN 0
		WARP TO 0, 2, 5
	END

	IF PLAYER NEAR 8, 8
	THEN
		TEXT BOX "CARTEL: TIENDA DEL SGT. BOSCO ALBERT ;M.A.; BARACUS."
		REENTER
	END
END

# Zunda Zunda
ENTERING SCREEN 19
	IF TRUE
	THEN
		SET TILE (1, 6) = 23
	END
END

PRESS FIRE AT SCREEN 19
	IF PLAYER NEAR 1, 6
	THEN
		TEXT BOX "GENIO: QUIERES ENTRAR AL CASTILLO, VERDAD NINJAJAR? QUE BIEN..."
		TEXT BOX "GENIO: VEO QUE TU VOLUNTAD DE CATAR TOTETE ES FUERTE!"
		TEXT BOX "GENIO: NO TENGO CLARO COMO ABRIR LA PUERTA, PERO ME SE UN POEMA"
		TEXT BOX "GENIO: DICEN QUE CONTIENE LA CLAVE PARA PODER ENTRAR... ESCUCHA:"
		REDRAW
		SET TILE (1, 6) = 23
		TEXT BOX "GENIO: ;EL AGUA FLUYE ANTES QUE LA PIEDRA;"
		TEXT BOX "GENIO: ;ESTRELLA Y HOJA, EN LOS EXTREMOS;"
		TEXT BOX "GENIO: ;LUEGO LA LUNA SIGUE A LA HOJA;"
		TEXT BOX "GENIO: ;LA PIEDRA QUEDA JUNTO A LA ESTRELLA;"
		TEXT BOX "GENIO: ;SI INSISTES, ADEMAS, HAY REGALITO;"
		TEXT BOX "GENIO: EA, YA NO TE PUEDO DECIR MAS. JUYE!!!"
		REENTER
	END
END
