ROOMS = 20
ITEM SLOT = 3
ITEM EMPTY = 0
TEXT WIDTH = 22
ALIAS %A = 7
ALIAS %B = 8

ENTERING GAME
	IF TRUE
	THEN
		%A = 1
		EXTERN 1, 2
		SHOW
		RECHARGE
		PAUSE 10
		SOUND 3
		TEXT BOX "HELLO WORLD"
		TEXT "HOLA"
		WARP TO 3, 4, 5
		SET TILE 1, 2 = 3
		SET BEH 4, 5 = 6
		PRINT TILE 7, 8 = 9
		INC %A 2
		DEC %A %B
		DECOS
			1, 2, 3
			4, 5, 6
		END
	END
END

ENTERING ANY
	IF %A = %B
	IF %A < 5
	IF %A >= 5
	IF %A <> 3
	THEN
		KILLED = 0
		OBJS = 1
		LIFE = 2
		PX = 16
		PY = 32
		HIDE_HOTSPOTS = 1
		DONT_MAKE_FANTIES = 0
		EN_T = 1
		EN_X = 2
		EN_Y = 3
		OPANT = 4
		PARAM = 5
		NPANT = 6
		INC KILLED 1
		DEC LIFE 1
	END
	IF NPANT = PX
	IF PY >= TX
	IF TY <> TN
	IF HOTSPOT = KILLED
	IF OBJS = LIFE
	IF HIDE_HOTSPOTS = DONT_MAKE_FANTIES
	IF EN_T = EN_N
	IF EN_X = EN_Y
	IF OPANT = PARAM
	THEN
		RERUN 1
	END
	IF PLAYER IN_X 1, 2
	IF PLAYER IN_Y 3, 4
	IF PLAYER AT 5, 6
	IF PLAYER FALLING
	THEN
		GAME OVER
	END
	IF PLAYER NOT_FALLING
	IF PLAYER STILL
	IF TILE AT 1, 2 = 3
	IF BEH AT 4, 5 = 6
	THEN
		%A = TILE AT 1, 2
		%B = BEH AT 3, 4
		%A = DIALOG "ONE", "TWO", "THREE"
		CALL SUBX
		BREAK
	END
END

PLAYER GOT SOMETHING
	IF HOTSPOT = 1
	THEN
		GET ITEM SET $9
		WIN GAME
	END
END

SUB SUBX
	IF TRUE
	THEN
		SOUND 1
	END
END

ENTERING SCREEN 3, 4
	IF TRUE
	THEN
		SOUND 2
	END
END

PRESS FIRE AT SCREEN 5
	IF TRUE
	THEN
		SOUND 4
	END
END
