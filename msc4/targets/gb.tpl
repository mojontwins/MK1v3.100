; MSC4 interpreter template - target family: gb (Game Boy DMG, SM83, RGBDS)
;
; Same chunk format as z80.tpl (see its header): a chunk is written only when its "when"
; expression holds, so the generated interpreter only contains the opcodes a script uses.
; The output is meant to be INCLUDEd by the engine's engine/script.asm, inside its ROM0 section.
;
; Engine side contract (variables in engine/ram.inc):
;   script_n script_ptr script_skip sc_x sc_y script_param script_result
;   n_pant on_pant gpx gpy tpx tpy tqt hotspot_t p_killed p_objs p_life p_possee p_gotten
;   player_vx player_vy t_en_t t_en_x t_en_y enit flags map_attr
;   scenery_hide_hotspots scenery_dont_make_rr
; Engine routines used: qtile attr_2 idx15 set_map_tile_t put_tile sfx_play wait_vblank present
;   draw_line_of_text run_text_box run_dialog do_extern_action
; {ENTERING_INDEX_OFFSET} {ITEM_SLOT} {ITEM_EMPTY} are substituted by msc4.
;
; Style notes: labels at column 0 (msc4 does not indent lines that end in ":"), local labels per
; scope: script_do / script_clausule / script_actions / read_vbyte / read_i_v.

;@ always
; ---- generated by msc4 from targets/gb.tpl - do not edit ----
script_do:
	ld a, [script_n]
;@ when jumptable
	cp {ENTERING_INDEX_OFFSET}
	jr nc, .jt
;@ always
	ld l, a
	ld h, 0
	add hl, hl
	ld bc, script_bytecode
	add hl, bc
	ld a, [hl+]
	ld e, a
	ld a, [hl]
	ld d, a
	or e
	ret z
;@ when jumptable
	jr .mk
.jt:
	ld hl, script_jt
.s:
	ld a, [hl+]
	cp $FF
	ret z
	ld b, a
	ld a, [script_n]
	cp b
	jr z, .fnd
	inc hl
	inc hl
	jr .s
.fnd:
	ld a, [hl+]
	ld e, a
	ld a, [hl]
	ld d, a
;@ always
.mk:
	ld hl, script_bytecode
	add hl, de
	STHL16 script_ptr
script_loop:
	LDHL16 script_ptr
	ld a, [hl]
	ld c, a
	ld b, 0
	push hl
	add hl, bc
	STHL16 script_skip
	pop hl
	inc hl
	STHL16 script_ptr
	ld a, c
	cp $FF
	ret z
script_clausule:
	call read_byte
	cp $FF
	jp z, script_actions

; ---- conditions -----------------------------------------------------------------------
;@ when cu:01
; IF A = B
	cp $01
	jp nz, .c01_end
	call read_vbyte
	ld b, a
	call read_vbyte
	cp b
	jp nz, skip_clausule
	jp script_clausule
.c01_end:
;@ when cu:02
; IF A < B
	cp $02
	jp nz, .c02_end
	call read_vbyte
	ld c, a
	call read_vbyte
	ld b, a
	ld a, c
	cp b
	jp nc, skip_clausule
	jp script_clausule
.c02_end:
;@ when cu:03
; IF A >= B
	cp $03
	jp nz, .c03_end
	call read_vbyte
	ld c, a
	call read_vbyte
	ld b, a
	ld a, c
	cp b
	jp c, skip_clausule
	jp script_clausule
.c03_end:
;@ when cu:04
; IF A <> B
	cp $04
	jp nz, .c04_end
	call read_vbyte
	ld b, a
	call read_vbyte
	cp b
	jp z, skip_clausule
	jp script_clausule
.c04_end:
;@ when cu:05
; IF NPANT = N
	cp $05
	jp nz, .c05_end
	call read_vbyte
	ld b, a
	ld a, [n_pant]
	cp b
	jp nz, skip_clausule
	jp script_clausule
.c05_end:
;@ when cu:21
; IF PLAYER IN_X (X1, X2)
	cp $21
	jp nz, .c21_end
	call read_vbyte
	ld c, a
	ld a, [gpx]
	cp c
	jp c, skip_clausule
	ld a, [gpx]
	ld c, a
	call read_vbyte
	cp c
	jp c, skip_clausule
	jp script_clausule
.c21_end:
;@ when cu:22
; IF PLAYER IN_Y (Y1, Y2)
	cp $22
	jp nz, .c22_end
	call read_vbyte
	ld c, a
	ld a, [gpy]
	cp c
	jp c, skip_clausule
	ld a, [gpy]
	ld c, a
	call read_vbyte
	cp c
	jp c, skip_clausule
	jp script_clausule
.c22_end:
;@ when cu:23
; IF PLAYER AT (X, Y)
	cp $23
	jp nz, .c23_end
	ld a, [tpx]
	ld c, a
	call read_vbyte
	cp c
	jp nz, skip_clausule
	ld a, [tpy]
	ld c, a
	call read_vbyte
	cp c
	jp nz, skip_clausule
	jp script_clausule
.c23_end:
;@ when cu:24
; IF PLAYER FALLING: nothing under the feet and no platform
	cp $24
	jp nz, .c24_end
	ld a, [p_possee]
	ld b, a
	ld a, [p_gotten]
	or b
	jp nz, skip_clausule
	jp script_clausule
.c24_end:
;@ when cu:25
; IF PLAYER NOT FALLING
	cp $25
	jp nz, .c25_end
	ld a, [p_possee]
	ld b, a
	ld a, [p_gotten]
	or b
	jp z, skip_clausule
	jp script_clausule
.c25_end:
;@ when cu:26
; IF PLAYER STILL: vx = vy = 0
	cp $26
	jp nz, .c26_end
	ld a, [player_vx]
	ld hl, player_vx + 1
	or [hl]
	ld hl, player_vy
	or [hl]
	ld hl, player_vy + 1
	or [hl]
	jp nz, skip_clausule
	jp script_clausule
.c26_end:
;@ when cu:30
; IF TILE AT (X, Y) = T
	cp $30
	jp nz, .c30_end
	call read_x_y
	ld a, [sc_x]
	ld c, a
	ld a, [sc_y]
	call qtile
	ld c, a
	call read_vbyte
	cp c
	jp nz, skip_clausule
	jp script_clausule
.c30_end:
;@ when cu:31
; IF BEH AT (X, Y) = B
	cp $31
	jp nz, .c31_end
	call read_x_y
	ld a, [sc_x]
	ld c, a
	ld a, [sc_y]
	call attr_2
	ld c, a
	call read_vbyte
	cp c
	jp nz, skip_clausule
	jp script_clausule
.c31_end:
;@ always
; unknown / TRUE ($F0): ignore
	jp script_clausule
skip_clausule:
	LDHL16 script_skip
	STHL16 script_ptr
	jp script_loop
script_actions:
	call read_byte
	cp $FF
	jp z, script_loop

; ---- actions --------------------------------------------------------------------------
;@ when au:00
; FLAGS[N] = V
	cp $00
	jp nz, .a00_end
	call read_i_v
	ld [hl], a
	jp script_actions
.a00_end:
;@ when au:01
; FLAGS[N] += V
	cp $01
	jp nz, .a01_end
	call read_i_v
	ld b, [hl]
	add a, b
	ld [hl], a
	jp script_actions
.a01_end:
;@ when au:02
; FLAGS[N] -= V
	cp $02
	jp nz, .a02_end
	call read_i_v
	ld b, a
	ld a, [hl]
	sub b
	ld [hl], a
	jp script_actions
.a02_end:
;@ when au:20
; SET TILE (X, Y) = T
	cp $20
	jp nz, .a20_end
	call read_x_y
	call read_vbyte
	ld d, a
	ld a, [sc_x]
	ld b, a
	ld a, [sc_y]
	ld c, a
	ld a, d
	call set_map_tile_t
	jp script_actions
.a20_end:
;@ when au:21
; SET BEH (X, Y) = B
	cp $21
	jp nz, .a21_end
	call read_x_y
	ld a, [sc_x]
	ld c, a
	ld a, [sc_y]
	call idx15
	ld c, a
	ld b, 0
	call read_vbyte
	ld hl, map_attr
	add hl, bc
	ld [hl], a
	jp script_actions
.a21_end:
;@ when au:22
; DECOS: t, xy ... $FF
	cp $22
	jp nz, .a22_end
.a22_loop:
	call read_byte
	cp $FF
	jp z, script_actions
	ld d, a
	call read_byte
	ld b, a
	and $0F
	ld c, a
	ld a, b
	swap a
	and $0F
	ld b, c
	ld c, a
	ld a, d
	call set_map_tile_t
	jr .a22_loop
.a22_end:
;@ when au:30
; GET ITEM SET $F
	cp $30
	jp nz, .a30_end
	call read_vbyte
	ld c, a
	ld b, 0
	ld hl, flags
	add hl, bc
	ld a, [flags + {ITEM_SLOT}]
	cp {ITEM_EMPTY}
	jp nz, script_actions
	ld a, 1
	ld [hl], a
	ld a, [tqt]
	ld [flags + {ITEM_SLOT}], a
	ld a, [tpx]
	ld b, a
	ld a, [tpy]
	ld c, a
	xor a
	call set_map_tile_t
	jp script_actions
.a30_end:
;@ when au:50
; PRINT TILE x, y, t (room character coordinates)
	cp $50
	jp nz, .a50_end
	call read_vbyte
	ld b, a
	call read_vbyte
	ld c, a
	call read_vbyte
	call put_tile
	jp script_actions
.a50_end:
;@ when au:6D
; WARP TO n, x, y
	cp $6D
	jp nz, .a6D_end
	call read_vbyte
	ld [n_pant], a
	call read_vbyte
	swap a
	and $F0
	ld [gpx], a
	call read_vbyte
	swap a
	and $F0
	ld [gpy], a
	jp script_actions
.a6D_end:
;@ when au:E0
; SOUND n
	cp $E0
	jp nz, .aE0_end
	call read_vbyte
	call sfx_play
	jp script_actions
.aE0_end:
;@ when au:E1
; SHOW: let the frame reach the screen
	cp $E1
	jp nz, .aE1_end
	call wait_vblank
	call present
	jp script_actions
.aE1_end:
;@ when au:E2
; RECHARGE
	cp $E2
	jp nz, .aE2_end
	ld hl, PLAYER_LIFE
	STHL16 p_life
	jp script_actions
.aE2_end:
;@ when au:E3
; TEXT l <chars> 0
	cp $E3
	jp nz, .aE3_end
	call read_byte
	ld c, a
	ld b, 0
	LDHL16 script_ptr
	push hl
	add hl, bc
	STHL16 script_ptr
	pop hl
	call draw_line_of_text
	jp script_actions
.aE3_end:
;@ when au:E4
; EXTERN n m
	cp $E4
	jp nz, .aE4_end
	call read_x_y
	ld a, [sc_y]
	ld b, a
	ld a, [sc_x]
	call do_extern_action
	jp script_actions
.aE4_end:
;@ when au:E5
; PAUSE n (50 Hz frames -> vblanks)
	cp $E5
	jp nz, .aE5_end
	call read_vbyte
	ld c, a
	srl a
	srl a
	add a, c
	ld b, a
	or a
	jp z, script_actions
.aE5_loop:
	call wait_vblank
	call present
	dec b
	jr nz, .aE5_loop
	jp script_actions
.aE5_end:
;@ when au:E6
; TEXT BOX lsb msb
	cp $E6
	jp nz, .aE6_end
	call read_addr
	call run_text_box
	jp script_actions
.aE6_end:
;@ when au:F0
; WIN GAME
	cp $F0
	jp nz, .aF0_end
	ld a, 1
	ld [script_result], a
	ret
.aF0_end:
;@ when au:F1
; GAME OVER
	cp $F1
	jp nz, .aF1_end
	ld a, 2
	ld [script_result], a
	ret
.aF1_end:
;@ when au:F2
; BREAK
	cp $F2
	jp nz, .aF2_end
	ret
.aF2_end:
;@ when au:F3
; RERUN v
	cp $F3
	jp nz, .aF3_end
	call read_vbyte
	ld [script_param], a
	jp script_do
.aF3_end:
;@ when au:F4
; CALL lsb msb: run a subroutine recursively
	cp $F4
	jp nz, .aF4_end
	call read_addr
	ld d, h
	ld e, l
	LDHL16 script_ptr
	push hl
	ld hl, script_bytecode
	add hl, de
	STHL16 script_ptr
	call script_loop
	pop hl
	STHL16 script_ptr
	jp script_actions
.aF4_end:
;@ always
; unknown action: ignore
	jp script_actions

; ---- helpers --------------------------------------------------------------------------
read_byte:
; A = next byte of the script; preserves BC DE HL
	push hl
	LDHL16 script_ptr
	ld a, [hl+]
	push af
	STHL16 script_ptr
	pop af
	pop hl
	ret
;@ when au:E6|au:F4|au:70|rv:E6
read_addr:
; HL = next 16-bit word
	call read_byte
	ld c, a
	call read_byte
	ld h, a
	ld l, c
	ret
;@ when cu:30|cu:31|au:20|au:21|au:E4|rv:E7|rv:E8
read_x_y:
	call read_vbyte
	ld [sc_x], a
	call read_vbyte
	ld [sc_y], a
	ret
;@ always
read_vbyte:
; A = value: direct byte, or $FF-prefixed flag / pseudo flag expression (recursive)
	call read_byte
	cp $FF
	ret nz
	call read_vbyte
;@ when rv:FE
	cp $FE
	jr nz, .rv_FE_end
	ld a, [n_pant]
	ret
.rv_FE_end:
;@ when rv:FD
	cp $FD
	jr nz, .rv_FD_end
	ld a, [gpx]
	ret
.rv_FD_end:
;@ when rv:FC
	cp $FC
	jr nz, .rv_FC_end
	ld a, [gpy]
	ret
.rv_FC_end:
;@ when rv:FB
	cp $FB
	jr nz, .rv_FB_end
	ld a, [p_killed]
	ret
.rv_FB_end:
;@ when rv:FA
	cp $FA
	jr nz, .rv_FA_end
	ld a, [p_objs]
	ret
.rv_FA_end:
;@ when rv:F9
	cp $F9
	jr nz, .rv_F9_end
	ld a, [p_life]
	ret
.rv_F9_end:
;@ when rv:F8
	cp $F8
	jr nz, .rv_F8_end
	ld a, [tpx]
	ret
.rv_F8_end:
;@ when rv:F7
	cp $F7
	jr nz, .rv_F7_end
	ld a, [tpy]
	ret
.rv_F7_end:
;@ when rv:F6
	cp $F6
	jr nz, .rv_F6_end
	ld a, [tqt]
	ret
.rv_F6_end:
;@ when rv:F5
	cp $F5
	jr nz, .rv_F5_end
	ld a, [hotspot_t]
	ret
.rv_F5_end:
;@ when rv:F0
	cp $F0
	jr nz, .rv_F0_end
	ld a, [scenery_hide_hotspots]
	ret
.rv_F0_end:
;@ when rv:EF
	cp $EF
	jr nz, .rv_EF_end
	ld a, [scenery_dont_make_rr]
	ret
.rv_EF_end:
;@ when rv:EE
	cp $EE
	jr nz, .rv_EE_end
	ld a, [t_en_t]
	ret
.rv_EE_end:
;@ when rv:ED
	cp $ED
	jr nz, .rv_ED_end
	ld a, [enit]
	ret
.rv_ED_end:
;@ when rv:EC
	cp $EC
	jr nz, .rv_EC_end
	ld a, [t_en_x]
	ret
.rv_EC_end:
;@ when rv:EB
	cp $EB
	jr nz, .rv_EB_end
	ld a, [t_en_y]
	ret
.rv_EB_end:
;@ when rv:EA
	cp $EA
	jr nz, .rv_EA_end
	ld a, [on_pant]
	ret
.rv_EA_end:
;@ when rv:E9
	cp $E9
	jr nz, .rv_E9_end
	ld a, [script_param]
	ret
.rv_E9_end:
;@ when rv:E8
; TILE AT (x, y)
	cp $E8
	jr nz, .rv_E8_end
	push bc
	call read_x_y
	ld a, [sc_x]
	ld c, a
	ld a, [sc_y]
	call qtile
	pop bc
	ret
.rv_E8_end:
;@ when rv:E7
; BEH AT (x, y)
	cp $E7
	jr nz, .rv_E7_end
	push bc
	call read_x_y
	ld a, [sc_x]
	ld c, a
	ld a, [sc_y]
	call attr_2
	pop bc
	ret
.rv_E7_end:
;@ when rv:E6
; DIALOG "a", "b", "c"
	cp $E6
	jr nz, .rv_E6_end
	push bc
	call read_addr
	STHL16 addr1
	call read_addr
	STHL16 addr2
	call read_addr
	STHL16 addr3
	call run_dialog
	pop bc
	ret
.rv_E6_end:
;@ always
	push hl
	ld e, a
	ld d, 0
	ld hl, flags
	add hl, de
	ld a, [hl]
	pop hl
	ret
;@ when au:00|au:01|au:02
read_i_v:
; reads an lvalue and an rvalue: HL -> variable, A = value
	call read_vbyte
	ld c, a
	call read_vbyte
	ld [sc_y], a
	ld a, c
;@ when lv:FE
	cp $FE
	ld hl, n_pant
	jr z, .cont
;@ when lv:FD
	cp $FD
	ld hl, gpx
	jr z, .cont
;@ when lv:FC
	cp $FC
	ld hl, gpy
	jr z, .cont
;@ when lv:FB
	cp $FB
	ld hl, p_killed
	jr z, .cont
;@ when lv:FA
	cp $FA
	ld hl, p_objs
	jr z, .cont
;@ when lv:F9
	cp $F9
	ld hl, p_life
	jr z, .cont
;@ when lv:F0
	cp $F0
	ld hl, scenery_hide_hotspots
	jr z, .cont
;@ when lv:EF
	cp $EF
	ld hl, scenery_dont_make_rr
	jr z, .cont
;@ when lv:EE
	cp $EE
	ld hl, t_en_t
	jr z, .cont
;@ when lv:EC
	cp $EC
	ld hl, t_en_x
	jr z, .cont
;@ when lv:EB
	cp $EB
	ld hl, t_en_y
	jr z, .cont
;@ when lv:EA
	cp $EA
	ld hl, on_pant
	jr z, .cont
;@ when lv:E9
	cp $E9
	ld hl, script_param
	jr z, .cont
;@ when au:00|au:01|au:02
	ld b, 0
	ld hl, flags
	add hl, bc
.cont:
	ld a, [sc_y]
	ret

; ---- section lookup table (jumptable mode): room -> bytecode offset -----------------------
;@ when jumptable
script_jt:
;@ foreach jt when jumptable
; {comment}
;@ next
	db {index}
	dw ${offs4}
;@ end
;@ when jumptable
	db $FF
